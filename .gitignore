__pycache__/
*.pyc
out/*.png
.timer.json
build/
reference/inbox/*
!reference/inbox/README.md
.DS_Store
**/.DS_Store
reference/theory/*
!reference/theory/README.md
node_modules

# photographs of works, kept local; only attributed files are tracked
reference/*
!reference/ATTRIBUTION.md
!reference/README.md
!reference/manifest.json
!reference/principles.json
!reference/air/
!reference/fire/
!reference/fleur/
!reference/acanthus/
!reference/palmette/
!reference/scroll/

# personal photographs stay local until attributed and named in the manifest
# (see commit 04870c0 — do not stage an unattributed IMG_*)
IMG_*.JPG

# local deploy notes (scrubbed from the public docs)
LOCAL-DEPLOY.md

# local server and monitor logs
state/monitor.log
*.log

# mkdocs output
site/
workbench/g3-catalogue-cache.json

state/build-cache.json

# Astro
app/.astro/
app/dist/

# the local saved-tabs page (personal state, generated)
workbench/tabs.html
workbench/backups/
workbench/finder.backup.json
workbench/finder-stars.backup.json
state/backups/

# local user directory (app data, personal)
app/data/

# Prisma: local database and its journals
app/prisma/dev.db
app/prisma/dev.db-journal
app/prisma/dev.db-wal
app/prisma/dev.db-shm
app/.env

# database snapshots
state/backups/db/
workbench/finder.json

# per-write backup of workbench/starred.json: local repair only, not part of the record
data/*.backup.json
workbench/starred.backup.json

# snapshots made by scripts/archive.sh: deposit them, do not commit them
dist/

# the 3000 px print masters: local, re-rendered freely; git carries the lossless WebP
# The plate renders are derived: the records and the generator are in git, so a clone can
# rebuild them. Keep them out of the repository — masters and web copies both.
book/print/*

# ...except the two crossing indexes, which the operator named as the record: the dots on the
# plates (cuts.json) and the hidden spans (rail-holes.json). Both are under 1 MB, and each is
# rebuilt by scripts/print_plates.mjs; the guard regenerates them and compares.
!book/print/cuts.json
!book/print/rail-holes.json

# the web renders are working state while the look is being judged; commit the set at freeze

# test/study PNG outputs stay out of git: full-size plates live on disk, and
# only the compressed set the operator picks goes back in (2026-11-20)
workbench/png-study/

# the compression study images: on disk only, never in git
app/public/png-study/

# the uncompressed plate set stays on disk only
workbench/plates-orig/

# downloaded wheels kept locally, never part of the tree
*.whl

# the uncompressed RGBA plates: the source the compressed set is printed from
workbench/plates-rgba/

# generated by scripts/marginalia.mjs (the manifest is tracked)
app/public/ornaments/

# the uncompressed RGBA plates, served for the compare desks only
app/public/plates-rgba/

# plate and figure renders are derived: the records, the generator and the index are in git.
# A curve can keep its PNG in git with pngIgnored=false (scripts/curve_pngs_git.mjs adds it).
app/public/plates-web/*.png
app/public/figures/*.png

# the operator's own chat history, for /said/ only
data/said.json
data/said-deep2.json
# the rolling checklist made from /said/: same personal history, local only
state/SAID-CHECKLIST-int.md
state/SAID-DEEP2-CHECKLIST-int.md

# the workhorse queue and its logs are local state
state/jobs/

# Renders rewritten on every save: ignored, because each save would re-upload a blob.
# The others (curves, hybrid-figures, extra-curves, hub stills, workbench figures) are
# regenerated only when their source changes, so they stay tracked and cost nothing until then.
#   frames  scripts/frames_build.ts
app/public/frames/*.png

# the photo reduction: personal photographs and the downloads they come from.
# Nothing here is tracked until the operator chooses the ones to keep and their
# names are written down. See state/SPEC-photo-reduction-int.md.
photo-reduced/
photo-public/
photo-inbox/
_unzipped/
*.zip
IMG_*
PANO_*
VID_*
*.HEIC
*.heic
