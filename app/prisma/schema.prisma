// The database is the record for anything a human edits: names, importance,
// the turn and pieces of a curve set. The JSON registry stays as the read-only
// index that seeds this database.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Curve {
  uid       String  @id
  name      String  @unique
  family    String?
  lists     String  // JSON array of list names
  aliases   String  // JSON array of former names
  starred   Boolean @default(false)
  candidate Boolean @default(false)
  createdAt DateTime @default(now())
  note      Note?
  metric    CurveMetric?
  sets      CurveSet[]
}

model Note {
  uid        String   @id
  curve      Curve?   @relation(fields: [uid], references: [uid])
  name       String?
  importance Int      @default(0)
  rotation   Int      @default(0)
  pieces     Int      @default(1)
  borderUid  String?
  perSide    Int      @default(0)   // 0 = the default rule; 3..40 otherwise
  borderTurn Int      @default(0)   // 0, 90: lay the border motif on its side
  offsets    Int      @default(0)   // 0 = spine only; 1 = draw the rails
  widthPct   Int      @default(0)   // 0 = plate_math DEFAULT_WIDTH
  plus       Int      @default(0)   // 0 = plate_math DEFAULT_PLUS
  minus      Int      @default(0)   // 0 = plate_math DEFAULT_MINUS
  profile    String?                // bow, s, taper, or null for the default
  formula    String?                // the canonical formula, as JSON text
  params     String?                // the construction, as JSON text
  grid       String?                // the exact grid, 1/G
  stationRule String?               // how the stations were placed
  algorithm  String?                // rows, path, prime-mover, hybrid …
  conversion String?                // JSON: what it came from, and the improved formula's slot
  updatedAt  DateTime @updatedAt
}

model CurveSet {
  uid        String @id
  name       String
  innerUid   String
  inner      Curve  @relation(fields: [innerUid], references: [uid])
  borderUid  String
  rotation   Int    @default(0)
  pieces     Int    @default(1)
  perSide    Int    @default(9)
  importance Int    @default(0)
}

// A finder star: the curve the person kept. The name matches Curve.name or an
// alias, so a star survives a rename of the display name.
model Star {
  name      String   @id
  note      String?
  spec      String?  // JSON, the definition the finder showed
  createdAt DateTime @default(now())
}

// A plate starred in the lab, for the book gallery.
model PlateStar {
  id        String   @id
  note      String?
  createdAt DateTime @default(now())
}

// A person in the lab's directory. Not a login: no password field exists.
model User {
  id        String   @id
  name      String
  email     String?
  role      String   @default("viewer")
  notes     String?
  created   DateTime @default(now())
  updated   DateTime @updatedAt
}

// A curve saved from the sandbox. The record is the page's own pair record,
// stored as JSON so the rows and terms stay exactly as written.
model SandboxCurve {
  name      String   @id
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The inter-agent message bus. One row is one message; an unacked row is the
// inbox, an acked row is the history. Ordering per (fromAgent, toAgent) is the
// row id. The body is JSON text, validated before it is stored.
model Message {
  id        Int       @id @default(autoincrement())
  fromAgent String
  toAgent   String
  topic     String
  body      String
  createdAt DateTime  @default(now())
  ackedAt   DateTime?
  attempts  Int       @default(0)

  @@index([toAgent, ackedAt, id])
  @@index([fromAgent, toAgent, id])
}

// One row per agent session. The database is the source of truth for who is
// working, on what, and when they were last seen. The mailbox is the narrative.
model Session {
  id       String   @id
  role     String
  model    String
  state    String   @default("idle")   // idle, working
  job      String?
  lastSeen DateTime @default(now())
}

// One row per job. `files` is a JSON array; an active job owns those files, and
// a second active job naming the same file is refused by the claim check.
model Job {
  id        String   @id
  owner     String
  files     String   // JSON array of paths
  state     String   @default("queued") // queued, active, done, blocked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

// What is measured about a curve, so two curves can be compared as numbers
// rather than by eye. Written by scripts/analyse_curves.py (exact core where
// the curve has speed rows) and loaded by app/scripts/load-analysis.mjs.
model CurveMetric {
  uid            String   @id
  curve          Curve    @relation(fields: [uid], references: [uid])
  family         String?
  kind           String            // rows | path | rational
  method         String            // exact | sampled
  degree         Int      @default(0)
  step           Float    @default(1)
  grid           BigInt   @default(0)  // exact integer; may exceed 2^53
  bend           Float    @default(0)
  arc            Float    @default(0)
  chord          Float    @default(0)
  inflections    Int      @default(0)
  inflectionMax  Int      @default(0)
  closest        Float    @default(0)
  crossings      Int      @default(0)
  meetingPoints  Int      @default(0)
  bboxW          Float    @default(0)
  bboxH          Float    @default(0)
  area           Float    @default(0)
  maxCurvature   Float    @default(0)
  curvatureMedian Float   @default(0)  // dimensionless: kappa x the curve's size
  mirrorY        Float    @default(0)
  halfTurn       Float    @default(0)
  mirrorYX       Float    @default(0)
  computedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
