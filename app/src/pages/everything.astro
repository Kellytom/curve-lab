---
// Every older workbench page, as a link list: the hub stays short, this page
// carries the rest. No iframes — it opens instantly.
import { buildHub } from "../lib/pages.js";

const hub = buildHub();
const sections = hub.sections;
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Everything else: draft A</title>
<link rel="stylesheet" href="/vendor/pico.min.css">
<link rel="stylesheet" href="/vendor/curve-lab-theme.css">
<style is:global>
/* only the two-column link list; everything else is Pico */
.links{display:grid;grid-template-columns:repeat(auto-fill,minmax(22rem,1fr));gap:.6rem;padding:0}
.links li{list-style:none;margin:0}
.links a{font-weight:600;text-decoration:none}
.links p{margin:.1rem 0 0;font-size:.75rem;color:var(--pico-muted-color)}
</style></head><body>
<div class="draft-a" style="position:fixed;right:.75rem;bottom:.75rem;z-index:9999;background:#1b1b1b;color:#fff;font:12px/1.4 system-ui,sans-serif;padding:.35rem .6rem;border-radius:.25rem;opacity:.9">draft A</div>
<nav class="container-fluid" style="font-size:.78rem">
  <a href="/" style="color:#8c6a21">the hub</a> · <a href="/finder" style="color:#8c6a21">curve finder</a> ·
  <a href="/ph-nth-sandbox" style="color:#8c6a21">PH nth sandbox</a> · <a href="/lab" style="color:#8c6a21">lab</a> ·
  <a href="/book" style="color:#8c6a21">book</a>
</nav>
<main class="container">
<h1>Everything else</h1>
<p class="lead">{hub.total - hub.app.length} older pages · every one still generated and still working ·
  grouped by what you are looking for</p>
{sections.map((section) => (
  <section id={section.key}>
    <h2>{section.label}</h2>
    <ul class="links">
      {section.pages.map((page) => (
        <li><a href={page.src}>{page.title}</a><p>{page.purpose}</p></li>
      ))}
    </ul>
  </section>
))}
</main>
</body></html>
