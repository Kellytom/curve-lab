---
import { getCollection, render } from "astro:content";

import AppNav from "../../components/AppNav.astro";
const posts = await getCollection("blog");
const post = posts.find((entry) => entry.id === Astro.params.slug);
if (!post) return Astro.redirect("/blog", 303);
const { Content } = await render(post);
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{post.data.title}</title>
<link rel="stylesheet" href="/vendor/pico.min.css">
<link rel="stylesheet" href="/vendor/curve-lab-theme.css">
<link rel="stylesheet" href="/vendor/app-shell.css">
</head><body>
<AppNav title="a note" />
<main id="main" class="container">
  <h1>{post.data.title}</h1>
  <p><small>{post.data.date.toISOString().slice(0, 10)}{post.data.draft ? " · draft" : ""}</small></p>
  <article><Content /></article>
  <p><a href="/blog">all notes</a></p>
</main>
</body></html>
