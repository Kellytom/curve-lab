---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = await getCollection("blog");
const post = posts.find((entry) => entry.id === Astro.params.slug);
if (!post) return Astro.redirect("/blog", 303);
const { Content } = await render(post);
---

<BaseLayout title="a note" pageTitle={post.data.title}>
  <h1>{post.data.title}</h1>
  <p><small>{post.data.date.toISOString().slice(0, 10)}{post.data.draft ? " · draft" : ""}</small></p>
  <article><Content /></article>
  <p><a href="/blog">all notes</a></p>
</BaseLayout>
