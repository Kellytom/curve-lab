---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Notes</title>
<link rel="stylesheet" href="/vendor/pico.min.css">
<link rel="stylesheet" href="/vendor/curve-lab-theme.css">
</head><body>
<nav class="container-fluid">
  <ul><li><strong>curve-lab</strong></li></ul>
  <ul>
    <li><a href="/">hub</a></li>
    <li><a href="/lab">lab</a></li>
    <li><a href="/book">book</a></li>
    <li><a href="/finder">finder</a></li>
    <li><a href="/users">users</a></li>
    <li><a href="/about">about</a></li>
  </ul>
</nav>
<main class="container">
  <h1>Notes</h1>
  <p>A blog, framed and ready. Nothing is published yet. A note is one Markdown
    file in <code>app/src/content/blog/</code> with a title, a date and a
    <code>draft</code> flag; it appears here on the next request.</p>

  {posts.length ? (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a>
          {post.data.draft ? <small> — draft</small> : null}
          <small> · {post.data.date.toISOString().slice(0, 10)}</small>
        </li>
      ))}
    </ul>
  ) : (
    <article>
      <p><em>No notes yet.</em></p>
      <p>To add one, create <code>app/src/content/blog/first-note.md</code>:</p>
      <pre><code>---
title: The first note
date: 2026-11-18
draft: true
---

The text.</code></pre>
    </article>
  )}
</main>
</body></html>
