---
// The finder candidates: the curves that were never starred. They are the
// candidate pool, not the collection, and they are kept so the pool is visible.
import { readFileSync } from "node:fs";
import path from "node:path";
import { loadRegistry } from "../lib/registry.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
const registry = (await loadRegistry()).curves;
const candidates = registry.filter((record) => record.candidate);
---

<BaseLayout title="the candidates" pageTitle="Sandbox notes: draft A" mainClass="">
  <Fragment slot="head">
    <style is:global>
    body{margin:0;padding:16px;background:#faf8f2;color:#222;font:13px/1.4 system-ui,sans-serif}
    h1{font-size:18px;margin:0 0 4px}
    p{color:#666;margin:0 0 16px;max-width:70ch}
    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    figure{margin:0;background:#fff;border:1px solid #ddd;padding:8px}
    img{display:block;width:100%;height:auto;background:#fff}
    figcaption{font-size:11px;color:#555;margin-top:6px;word-break:break-all}
    figcaption b{color:#222}
    </style>
  </Fragment>
  <h1>Finder candidates</h1>
  <p>{candidates.length} curves set aside: the finder curves that were never
    starred, and the chosen ones moved off the naming desk with <b>move to notes</b>.
    They stay in the registry so the pool is visible; they are not on the naming
    desk or in the gallery. <b>restore</b> puts one back on the desk.</p>
  <div class="grid">
    {candidates.map((record) => (
      <figure>
        <img src={`/curves/${record.uid}.png`} loading="lazy" alt={record.name}>
        <figcaption>
          {record.uid} · <b>{record.name}</b><br>
          {record.family_id}{record.aliases && record.aliases.length ? ` · was ${record.aliases[0]}` : ""}
          <button type="button" class="restore" data-uid={record.uid} title="put this curve back on the naming desk">restore</button>
        </figcaption>
      </figure>
    ))}
  </div>
  <Fragment slot="scripts">
    <script>import "../scripts/candidates.js";</script>
  </Fragment>
</BaseLayout>
