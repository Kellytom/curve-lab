---
// Every curve, one bordered PNG each. The margin the border takes is printed
// under each, so a curve whose frame is too wide can be swapped or turned.
import { readFileSync } from "node:fs";
import path from "node:path";
import { loadRegistry } from "../lib/registry.js";

const base = path.join(process.cwd(), "..");
const registry = (await loadRegistry(base)).curves;
const meta = new Map();
try {
  const index = JSON.parse(readFileSync(path.join(process.cwd(), "public", "figures", "index.json"), "utf8"));
  for (const item of index.curves || []) meta.set(item.uid, item);
} catch { /* the index is written by scripts/curve_pngs.mjs */ }
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Every curve: draft A</title>
<link rel="stylesheet" href="/vendor/pico.min.css">
<style>
body{margin:0;padding:16px;background:#faf8f2;color:#222;font:13px/1.4 system-ui,sans-serif}
h1{font-size:18px;margin:0 0 4px}
p{color:#666;margin:0 0 16px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
figure{margin:0;background:#fff;border:1px solid #ddd;padding:8px}
img{display:block;width:100%;height:auto;background:#fff}
figcaption{font-size:11px;color:#555;margin-top:6px;word-break:break-all}
figcaption b{color:#222;font-weight:600}
.warn{color:#8a3b2a}
</style>
</head><body>
<div class="draft-a" style="position:fixed;right:.75rem;bottom:.75rem;z-index:9999;background:#1b1b1b;color:#fff;font:12px/1.4 system-ui,sans-serif;padding:.35rem .6rem;border-radius:.25rem;opacity:.9">draft A</div>
<h1>Every curve</h1>
<p>{registry.length} curves, one PNG each, cut from the same frame rule as the gallery.
  Under each: the border's share of the figure, and the copies per side.</p>
<div class="grid">
  {registry.map((record) => {
    const item = meta.get(record.uid) || {};
    const margin = item.marginPercent;
    return (
      <figure>
        <img src={`/figures/${record.uid}.png`} loading="lazy" alt={record.name}>
        <figcaption>
          {record.uid} · <b>{record.name}</b><br>
          {record.family_id} · {record.lists.join(", ")}<br>
          {item.failed
            ? <span class="warn">no frame: {item.reason || "the frame failed"}</span>
            : margin !== undefined
              ? <span class={margin >= 30 ? "warn" : ""}>border {margin}% · {item.perSide} a side</span>
              : "border not measured yet"}
        </figcaption>
      </figure>
    );
  })}
</div>
</body></html>
