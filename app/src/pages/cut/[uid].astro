---
// One double, its numbered cusps, and the cut.
//
// The picture is drawn here in the first paint so the numbers on the dots are the numbers the
// form offers. The cut runs on the server (/api/cut-double), which is the only place that
// writes a record; this page never cuts by itself.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRequire } from "node:module";
import path from "node:path";
import { repoRoot } from "../../lib/gallery.js";
import { loadRegistry } from "../../lib/registry.ts";
import { cuspsOf, lineRuns, lineY, turnPoints } from "../../lib/cut-doubles.js";
import { bandSvg, frame } from "../../scripts/tune-render.js";

// the one plate maths, read from disk as Node sees it (the same file the plate loads)
const require = createRequire(import.meta.url);
const plateFile = path.join(repoRoot(), "workbench", "plate_math.js");
delete require.cache[require.resolve(plateFile)];
const PLATE = require(plateFile);

const { uid } = Astro.params;
const registry = await loadRegistry();
const record = registry.curves.find((curve) => curve.uid === uid);
if (!record) return Astro.redirect("/cut/");
if (!/^double-/i.test(record.name || "") || !Array.isArray(record.path)) {
  return Astro.redirect("/cut/");
}

// The plate draws the record turned by its own `transform.degrees` (screen clockwise, so the
// model turns the other way). The desk must show the same orientation, or the curve the
// operator cuts is not the curve he saw on /plates.
const degrees = Number(record.transform?.degrees || 0);
const points = turnPoints(record.path, degrees);
const cusps = cuspsOf(record.path).map((cusp) => ({ ...cusp, point: turnPoints([cusp.point], degrees)[0] }));
const xs = points.map((p) => p[0]);
const ys = points.map((p) => p[1]);
const x0 = Math.min(...xs), x1 = Math.max(...xs);
const y0 = Math.min(...ys), y1 = Math.max(...ys);
const W = 860, PAD = 26;
const spanX = x1 - x0 || 1, spanY = y1 - y0 || 1;
const k = Math.min((W - 2 * PAD) / spanX, (W - 2 * PAD) / spanY);
const H = Math.round(spanY * k + 2 * PAD);
// +y is up: the screen flip is here, once
const px = ([x, y]) => [PAD + (x - x0) * k, H - PAD - (y - y0) * k];
const line = points.map((p, i) => `${i ? "L" : "M"}${px(p)[0].toFixed(1)},${px(p)[1].toFixed(1)}`).join("");
const dots = cusps.map((cusp, index) => {
  const [cx, cy] = px(cusp.point);
  return `<g><circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="13" fill="#7290c0" ` +
    `fill-opacity="0.9"/><text x="${cx.toFixed(1)}" y="${(cy + 4.5).toFixed(1)}" ` +
    `text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="13" ` +
    `fill="#ffffff">${index + 1}</text></g>`;
}).join("");
// the line cut, drawn where it will cut: horizontal through the middle of the drawn curve
const cutY = lineY(points);
const cutLineY = H - PAD - (cutY - y0) * k;
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="100%">
  <rect width="${W}" height="${H}" fill="#ffffff"/>
  <path d="${line}" fill="none" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round"/>
  <line x1="${PAD}" x2="${W - PAD}" y1="${cutLineY.toFixed(1)}" y2="${cutLineY.toFixed(1)}"
    stroke="#b03a2e" stroke-width="1.2" stroke-dasharray="8 6"/>
  ${dots}
</svg>`;
// The side curves are chosen here: the preview and the saved record use the same four values,
// read from the query string (the form's preview button reloads with them).
const q = Astro.url.searchParams;
const number = (name, fallback) => {
  const raw = q.get(name);
  return raw === null || raw === "" ? fallback : Number(raw);
};
const sideValues = {
  widthPct: number("widthPct", 1.5),
  plus: number("plus", 2.5),
  minus: number("minus", 0.1),
  profile: ["bow", "s", "taper"].includes(q.get("profile") || "") ? q.get("profile") : "bow",
};

const suggested = `${record.name}-cut`;

// The two curves the line makes, drawn here: each side's open runs with the same side curves
// the plate will draw, so the operator sees what he is choosing before saving. This is a view;
// the save is still the server's.
const sidePreview = (side) => {
  const runs = lineRuns(points, side);
  if (!runs.length) return { svg: "", runs: 0 };
  const groups = runs.map((run) => {
    const group = PLATE.pathGroup(run, {
      widthPercent: sideValues.widthPct, plus: sideValues.plus,
      minus: sideValues.minus, profile: sideValues.profile,
    });
    return group ? group.paths.slice(0, 3) : [run];
  });
  const box = frame(groups.flat());
  return {
    svg: box ? bandSvg(groups.length === 1 ? groups[0] : groups, box) : "",
    runs: runs.length,
  };
};
const topHalf = sidePreview("top");
const bottomHalf = sidePreview("bottom");
const saved = q.get("saved");
const savedUid = q.get("new");
const warning = q.get("warning");
const hasLine = true;
---

<BaseLayout title="the cut desk" pageTitle="The cut desk">
  <p class="lead"><b>{record.uid}</b> {record.name} · <a href="/cut/">all the doubles</a> ·
    <a href={`/tune/${record.uid}`}>tune it</a>. Two cuts: at a numbered dot, or across the red
    line — the top and bottom halves are drawn below, with their side curves, before you save.
    A cut adds a curve beside its parent; the parent stays as it is.</p>

  {saved && (
    <p class="cut-saved">saved: {saved}
      {savedUid && <> · <a href={`/plates#${savedUid}`}>see {savedUid} on the plates</a> ·
        <a href={`/tune/${savedUid}`}>tune its side curves or rename it</a></>}
      {warning && <span class="cut-note"> ({warning})</span>}
    </p>
  )}

  <div class="cut-one">
    <div class="cut-figure" set:html={svg} />
    <form class="cut-form" id="cut-form">
      <input type="hidden" name="uid" value={record.uid} />
      <label>cut
        <select name="mode">
          {cusps.map((cusp, index) => (
            <option value={`dot:${index}`}>at dot {index + 1} · {cusp.angle.toFixed(0)}°</option>
          ))}
          <option value="top">across the line · top half</option>
          <option value="bottom">across the line · bottom half</option>
        </select>
      </label>
      <label>keep <span class="cut-hint">(dot cuts)</span>
        <select name="keep">
          <option value="long">the long arc</option>
          <option value="short">the short arc</option>
        </select>
      </label>
      <label>width % <input name="widthPct" type="number" min="0.5" max="20" step="0.05" value={sideValues.widthPct} /></label>
      <label>plus <input name="plus" type="number" min="-8" max="8" step="0.05" value={sideValues.plus} /></label>
      <label>minus <input name="minus" type="number" min="-8" max="8" step="0.05" value={sideValues.minus} /></label>
      <label>profile
        <select name="profile">
          {["bow", "s", "taper"].map((name) => <option value={name} selected={sideValues.profile === name}>{name}</option>)}
        </select>
      </label>
      <label>new name
        <input name="name" type="text" maxlength="120" value={suggested} />
      </label>
      <button type="submit">preview the side curves</button>
      <button type="submit" id="cut-save">cut and save</button>
      <p class="cut-state" id="cut-state" role="status" aria-live="polite"></p>
      <p class="cut-note">The red dashed line is the horizontal cut: the top or bottom half is
        kept as open curves, not one closed shape. The four side values are the ones previewed
        below and saved with the cut; after saving they can be tuned at the curve's own tuning
        page. A cut is a sampled record ({points.length} stored points on the parent).</p>
    </form>
  </div>

  <section class="cut-halves">
    <h2>The two curves the line makes</h2>
    <div class="cut-halves-grid">
      <figure class="cut-half">
        <div set:html={topHalf.svg} />
        <figcaption>the top half · {topHalf.runs} open curve{topHalf.runs === 1 ? "" : "s"}</figcaption>
      </figure>
      <figure class="cut-half">
        <div set:html={bottomHalf.svg} />
        <figcaption>the bottom half · {bottomHalf.runs} open curve{bottomHalf.runs === 1 ? "" : "s"}</figcaption>
      </figure>
    </div>
    <p class="cut-note">Each is the original cut at the red line, with the same side curves the
      plate draws; a side with more than one run is saved as more than one curve. Choose one in
      the form above to save it.</p>
  </section>
</BaseLayout>

<script>
  import "../../scripts/cut-desk.js";
</script>

<style is:global>
  .cut-one { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; }
  .cut-figure { border: 1px solid #e6dccb; background: #fff; padding: 6px; }
  .cut-figure svg { display: block; width: 100%; height: auto; }
  .cut-form label { display: flex; justify-content: space-between; gap: 8px; align-items: baseline;
    font: 13px/1.5 ui-monospace, Menlo, monospace; margin: 0 0 8px; }
  .cut-form input, .cut-form select { width: 10rem; padding: 2px 4px; font-size: 13px; }
  .cut-form button { width: 100%; margin: 4px 0 0; }
  .cut-hint { color: #7a6a55; font-size: 12px; }
  .cut-state { min-height: 1.4em; margin: 8px 0 0; font: 13px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .cut-state.ok { color: #2f6f3a; }
  .cut-state.bad { color: #9b2c2c; }
  .cut-state.busy { color: #7a6a55; }
  .cut-note { font: 12px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .cut-saved { font: 13px/1.5 ui-monospace, Menlo, monospace; color: #2f6f3a; }
  .cut-halves { margin: 16px 0 0; }
  .cut-halves h2 { font-size: 1rem; margin: 0 0 6px; }
  .cut-halves-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cut-half { margin: 0; border: 1px solid #e6dccb; background: #fff; padding: 4px; }
  .cut-half svg { display: block; width: 100%; height: 300px; }
  .cut-half figcaption { margin-top: 4px; font: 12px/1.4 ui-monospace, Menlo, monospace; color: #6b5b46; }
  @media (max-width: 720px) { .cut-halves-grid { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .cut-one { grid-template-columns: 1fr; } }
</style>
