---
// The marginalia: every curve as a single-stroke ornament, four to a row.
// A quarter of the text width each, so the whole collection is one contact sheet.
import BaseLayout from "../layouts/BaseLayout.astro";
import marginalia from "../theme/marginalia/ornaments.json";

const curves = marginalia.curves || [];
const stars = (value) => (value ? `${value}/10` : "none");
---

<BaseLayout title="the marginalia" pageTitle="The marginalia">
  <h1>The marginalia</h1>
  <p class="lead">Every curve in the collection as one soft-stroke ornament, each at <b>a quarter of
    the text width</b> — four to a row, so the whole set is one contact
    sheet. The same ornaments appear in the margins of the docs: the page title, a section
    heading, the footer and the sidebar.</p>
  <p class="lead">{curves.length} curves · scale {marginalia.scale} · generated by
    <code>scripts/marginalia.mjs</code> · the template is
    <code>app/src/theme/marginalia/</code>.</p>

  <div class="ornament-grid">
    {curves.map((curve) => (
      <figure class="ornament-card">
        <span class="ornament" style={`--o: url("${curve.file}");`}></span>
        <figcaption><code>{curve.uid}</code> {curve.name} · stars {stars(curve.stars)}</figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .ornament-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 18px; }
  .ornament-card { margin: 0; padding: 8px; background: #fffef9; border: 1px solid #eee3d3; }
  .ornament {
    display: block; width: 100%; height: 190px; background-color: #3f3a33;
    -webkit-mask: var(--o) center / contain no-repeat;
    mask: var(--o) center / contain no-repeat;
  }
  .ornament-card figcaption { margin-top: 6px; font: 12px/1.4 ui-monospace, Menlo, monospace; color: #5a4a36; }
  .ornament-card figcaption code { color: #3f3a33; }
  @media (max-width: 900px) { .ornament-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
