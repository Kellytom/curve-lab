---
// The quintic sandbox: draw a stroke, get six points and a quintic, and give it a
// width that thins at the ends — the same reduction and fullness as the Inkscape
// extension (inkscape/quintic_guide.py), in the browser, so the shape can be felt
// before anything is installed.
//
// The operator, 2026-11-27: "make a sandbox in js here that does the same thing so
// we can play around with it… modulated offset curves… thin at the ends and thicker
// in the middle".
//
// The maths is app/src/lib/quintic-lab.ts (which re-exports scripts/lib/quintic-geometry.ts);
// the wiring is app/src/scripts/quintic-lab.ts. This page carries no rules.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Quintic sandbox — curve lab">
  <main>
    <h1>Quintic sandbox</h1>
    <p class="lede">
      Draw a stroke with a trackball or a pencil. The sandbox takes six points off it,
      draws the quintic through them, and swells the curve thin at the ends and thicker
      in the middle — the shape the side curves use. Same maths as the Inkscape
      extension: <code>app/src/lib/quintic-lab.ts</code>.
    </p>

    <section class="ql-pad-wrap">
      <svg id="ql-pad" viewBox="0 0 1000 540" role="application"
           aria-label="Draw a stroke with the pointer">
        <defs>
          <pattern id="ql-grid" width="50" height="50" patternUnits="userSpaceOnUse">
            <path d="M 50 0 L 0 0 0 50" fill="none" stroke="#e8e8e8" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="1000" height="540" fill="#ffffff"/>
        <rect width="1000" height="540" fill="url(#ql-grid)"/>
        <path id="ql-outline" fill="#1f3a5f" fill-opacity="0.16" stroke="#1f3a5f"
              stroke-width="0.8" stroke-opacity="0.9" d=""/>
        <path id="ql-rails-left" fill="none" stroke="#b9c6d6" stroke-width="1"
              stroke-dasharray="4 3" d=""/>
        <path id="ql-rails-right" fill="none" stroke="#b9c6d6" stroke-width="1"
              stroke-dasharray="4 3" d=""/>
        <path id="ql-guide" fill="none" stroke="#c0392b" stroke-width="1.2"
              stroke-dasharray="5 4" d=""/>
        <path id="ql-spine" fill="none" stroke="#111" stroke-width="1.1" d=""/>
        <g id="ql-points"></g>
        <text id="ql-readout" x="16" y="26" font-family="Helvetica, Arial, sans-serif"
              font-size="13" fill="#333"></text>
        <text x="16" y="528" font-family="Helvetica, Arial, sans-serif"
              font-size="11" fill="#777">x right, y up (the page flips y once, at drawing). Move the pointer to draw.</text>
      </svg>
    </section>

    <section class="ql-controls" aria-label="Quintic sandbox controls">
      <label class="ql-field">Six points are
        <select id="ql-mode">
          <option value="even" selected>On the curve, evenly spaced</option>
          <option value="lsq">A best fit</option>
        </select>
      </label>

      <label class="ql-field">Spans
        <input id="ql-spans-slider" type="range" min="1" max="8" step="1" value="2">
        <output id="ql-spans">2</output>
      </label>

      <label class="ql-field">Fullness (tension) α
        <input id="ql-fullness-slider" type="range" min="0" max="1" step="0.01" value="1">
        <output id="ql-fullness">1.00</output>
      </label>

      <label class="ql-field">Width at the ends, px
        <input id="ql-ends-slider" type="range" min="0" max="20" step="0.5" value="1">
        <output id="ql-ends">1.0</output>
      </label>

      <label class="ql-field">Width in the middle, px
        <input id="ql-middle-slider" type="range" min="0" max="40" step="0.5" value="14">
        <output id="ql-middle">14.0</output>
      </label>

      <label class="ql-field">Where the swell sits
        <input id="ql-peak-slider" type="range" min="0.1" max="0.9" step="0.01" value="0.5">
        <output id="ql-peak">0.50</output>
      </label>

      <label class="ql-field">Swell sharpness
        <input id="ql-power-slider" type="range" min="0.4" max="4" step="0.1" value="1">
        <output id="ql-power">1.0</output>
      </label>

      <label class="ql-field">Max cubic miss, px
        <input id="ql-tolerance-slider" type="range" min="0.001" max="1" step="0.001" value="0.05">
        <output id="ql-tolerance">0.050</output>
      </label>

      <label class="ql-check"><input id="ql-show-rails" type="checkbox" checked>
        Constant-width rails for comparison</label>
      <label class="ql-check"><input id="ql-show-points" type="checkbox" checked>
        Mark the six points</label>

      <span class="ql-buttons">
        <button id="ql-demo" type="button">Demo stroke</button>
        <button id="ql-clear" type="button">Clear</button>
      </span>
    </section>

    <p class="ql-note">
      The filled shape is the <strong>modulated offset</strong>: each side is the curve
      pushed along its own normal by the width at that t, so a swell in the middle is a
      stroke that is thin at the ends. Where the width changes faster than the curve can
      turn, the two sides cross — the readout counts that instead of hiding it.
    </p>
  </main>

  <script>import "../scripts/quintic-lab.ts";</script>

  <style is:global>
    .ql-pad-wrap { margin: 1.25rem 0 1rem; }
    #ql-pad { width: 100%; height: auto; display: block; border: 1px solid #d8d8d8;
              border-radius: 6px; touch-action: none; cursor: crosshair; background: #fff; }
    .ql-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                   gap: 0.6rem 1.5rem; align-items: end; margin: 0.5rem 0 1rem; }
    .ql-field { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.9rem; }
    .ql-field output { font-variant-numeric: tabular-nums; color: #555; }
    .ql-check { display: flex; gap: 0.45rem; align-items: center; font-size: 0.9rem; }
    .ql-buttons { display: flex; gap: 0.6rem; }
    .ql-buttons button { padding: 0.35rem 0.7rem; border: 1px solid #bbb; border-radius: 5px;
                         background: #f6f6f6; cursor: pointer; }
    .ql-note { max-width: 70ch; color: #444; }
    .lede { max-width: 70ch; }
  </style>
</BaseLayout>
