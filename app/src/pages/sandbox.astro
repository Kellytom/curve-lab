// Two sandboxes on one page, both from workbench/sandbox-adders.json:
//
//   the visual adder   every term drawn alone, three across, then the sum
//   the quadrature     the polynomial at a quarter turn, exact numbers where they exist
//
// Sampled drawings; the quadrature curves carry exact grid and inflection counts
// from the one core, so the page never claims exactness it does not have.
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repoRoot } from "../lib/gallery.js";

const data = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "sandbox-adders.json"), "utf8"));
// The parametric material lives in its own file; one page, two datasets.
const parametric = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "sandbox-parametric.json"), "utf8"));




// A fixed reference diagram: the two walks as coordinates, labelled, separated
// positive above and negative below. It is a drawing to read, not a calculation.
const REFERENCE_POSITIVE = [[1,0],[2,1],[3,4],[0.72,3.94],[-0.90,3.07],[-1.74,1.88],
  [-1.92,0.72],[-1.63,0.17],[-1.11,0.70],[-0.54,0.90],[-0.06,0.84],[0.25,0.62]];
const REFERENCE_NEGATIVE = [[1,0],[2,-1],[3,-4],[0.72,-3.94],[-0.90,-3.07],[-1.74,-1.88],
  [-1.92,-0.72],[-1.63,-0.17],[-1.11,-0.70],[-0.54,-0.90],[-0.06,-0.84],[0.25,-0.62]];

function referenceDiagram(size = 620) {
  const all = [...REFERENCE_POSITIVE, ...REFERENCE_NEGATIVE];
  const reach = Math.max(...all.map(([x, y]) => Math.max(Math.abs(x), Math.abs(y))), 1) + 0.6;
  const pad = 30;
  const k = (size - 2 * pad) / (2 * reach);
  const sx = (x) => size / 2 + x * k;
  const sy = (y) => size / 2 - y * k;
  const grid = [];
  for (let v = -Math.ceil(reach); v <= Math.ceil(reach); v += 1) {
    grid.push(`<line x1="${sx(v)}" y1="${sy(-reach)}" x2="${sx(v)}" y2="${sy(reach)}" stroke="${v === 0 ? "#b9a98a" : "#ece4d2"}" stroke-width="${v === 0 ? 1.1 : 0.6}"/>`);
    grid.push(`<line x1="${sx(-reach)}" y1="${sy(v)}" x2="${sx(reach)}" y2="${sy(v)}" stroke="${v === 0 ? "#b9a98a" : "#ece4d2"}" stroke-width="${v === 0 ? 1.1 : 0.6}"/>`);
  }
  const path = (points) => points.map(([x, y], i) => `${i ? "L" : "M"}${sx(x).toFixed(1)},${sy(y).toFixed(1)}`).join("");
  const labels = (points, fill, dy) => points.map(([x, y]) =>
    `<text x="${(sx(x) + 6).toFixed(1)}" y="${(sy(y) + dy).toFixed(1)}" font-family="ui-monospace,Menlo,monospace" font-size="9" fill="${fill}">${x.toFixed(2)}, ${y.toFixed(2)}</text>`).join("");
  const dots = (points, fill) => points.map(([x, y]) =>
    `<circle cx="${sx(x).toFixed(1)}" cy="${sy(y).toFixed(1)}" r="3.4" fill="${fill}"/>`).join("");
  return `<svg viewBox="0 0 ${size} ${size}" role="img" aria-label="reference: the two walks, positive above, negative below">
    <rect width="${size}" height="${size}" fill="#fffdf7"/>${grid.join("")}
    <path d="${path(REFERENCE_POSITIVE)}" fill="none" stroke="#e8b98a" stroke-width="1.6"/>
    <path d="${path(REFERENCE_NEGATIVE)}" fill="none" stroke="#9ec3df" stroke-width="1.6"/>
    ${dots(REFERENCE_POSITIVE, "#c9761f")}${dots(REFERENCE_NEGATIVE, "#2f6fa8")}
    ${labels(REFERENCE_POSITIVE, "#8c5a1a", -7)}${labels(REFERENCE_NEGATIVE, "#245480", 13)}
    <text x="${pad}" y="${size - 12}" font-family="ui-monospace,Menlo,monospace" font-size="10" fill="#8c6a21">separated · positive above, negative below</text>
  </svg>`;
}

const reference = referenceDiagram();

const wobble = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "wobble.json"), "utf8"));
const beziers = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "bezier-knots.json"), "utf8"));
const couplers = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "coupler-curves.json"), "utf8"));
const mobiles = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "mobile-curves.json"), "utf8"));
const window = data.window;

function box(points, size = 300) {
  const xs = points.map((p) => p[0]);
  const ys = points.map((p) => p[1]);
  const x0 = Math.min(...xs), x1 = Math.max(...xs);
  const y0 = Math.min(...ys), y1 = Math.max(...ys);
  return { x0, x1, y0, y1 };
}

function plot(points, { size = 300, pad = 22, axes = true } = {}) {
  const { x0, x1, y0, y1 } = box(points);
  const w = x1 - x0 || 1, h = y1 - y0 || 1;
  const k = (size - 2 * pad) / Math.max(w, h);
  const sx = (x) => pad + (x - x0) * k + ((size - 2 * pad) - w * k) / 2;
  const sy = (y) => size - pad - (y - y0) * k - ((size - 2 * pad) - h * k) / 2;
  const d = points.map(([x, y], i) => `${i ? "L" : "M"}${sx(x).toFixed(1)},${sy(y).toFixed(1)}`).join("");
  const zeroX = x0 <= 0 && x1 >= 0 ? sx(0) : null;
  const zeroY = y0 <= 0 && y1 >= 0 ? sy(0) : null;
  const axis = 'stroke="#b9a98a" stroke-width="1"';
  return `<svg viewBox="0 0 ${size} ${size}" role="img">
    <rect width="${size}" height="${size}" fill="#fffdf7"/>
    ${axes && zeroY !== null ? `<line x1="${pad}" y1="${zeroY}" x2="${size - pad}" y2="${zeroY}" ${axis}/>` : ""}
    ${axes && zeroX !== null ? `<line x1="${zeroX}" y1="${pad}" x2="${zeroX}" y2="${size - pad}" ${axis}/>` : ""}
    <path d="${d}" fill="none" stroke="#141414" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>`;
}

const label = (term) => {
  const sign = term.coef < 0 ? "−" : "";
  const size = Math.abs(term.coef) === 1 ? "" : String(Math.abs(term.coef));
  return `${sign}${size}x${term.power === 1 ? "" : `^${term.power}`}`;
};

// Three across, with the plus between; a full row ends with the plus that
// continues on the next line, so the sum reads as one line of typing.
function rowsOf(terms) {
  const rows = [];
  for (let i = 0; i < terms.length; i += 3) {
    const row = terms.slice(i, i + 3);
    const parts = [];
    row.forEach((term, index) => {
      parts.push({ term, plus: index < row.length - 1 });
    });
    rows.push({ parts, continues: i + 3 < terms.length });
  }
  return rows;
}
