---
// The trim desk: cut a curve's legs off at two rational fractions of its parameter.
//
// The operator, 2026-11-24: "cutting the legs off the curves using rational fractions of t".
// t = 0 is the first station and t = 1 the last; the stations between the two cuts are kept and
// the legs outside are dropped. The cut points sit exactly on the fractions by interpolating the
// one segment they fall on, and the record still says sampled between stations.
//
// The save is the server's (/api/trim-curve), the only place that writes a record.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRequire } from "node:module";
import path from "node:path";
import { repoRoot } from "../../lib/gallery.js";
import { loadRegistry } from "../../lib/registry.ts";
import { parseRange, trimRecord } from "../../lib/trim-curve.js";
import { turnPoints } from "../../lib/cut-doubles.js";
import { bandSvg, frame } from "../../scripts/tune-render.js";

const require = createRequire(import.meta.url);
const plateFile = path.join(repoRoot(), "workbench", "plate_math.js");
delete require.cache[require.resolve(plateFile)];
const PLATE = require(plateFile);

const { uid } = Astro.params;
const registry = await loadRegistry();
const record = registry.curves.find((curve) => curve.uid === uid);
if (!record || !Array.isArray(record.path) || record.path.length < 2) {
  return Astro.redirect("/trim/");
}

const q = Astro.url.searchParams;
const number = (name, fallback) => {
  const raw = q.get(name);
  return raw === null || raw === "" ? fallback : Number(raw);
};
const sideValues = {
  widthPct: number("widthPct", 1.5),
  plus: number("plus", 2.5),
  minus: number("minus", 0.1),
  profile: ["bow", "s", "taper"].includes(q.get("profile") || "") ? q.get("profile") : "bow",
};
const suggested = `${record.name}-trimmed`;
const fromText = q.get("from") ?? "1/4";
const toText = q.get("to") ?? "3/4";

let range = null;
let rangeError = "";
let trimmed = null;
try {
  range = parseRange(fromText, toText);
  trimmed = trimRecord(record, range.from, range.to);
  if (!trimmed || trimmed.path.length < 3) {
    rangeError = "that cut leaves too little to draw";
    trimmed = null;
  }
} catch (error) {
  rangeError = String(error.message || error);
}

// The plate draws the record turned by its own degrees; the desk shows the same curve.
const degrees = Number(record.transform?.degrees || 0);
const turned = (points) => turnPoints(points, degrees);
const whole = Array.isArray(record.branches) && record.branches.length
  ? record.branches.map(turned) : [turned(record.path)];
const kept = trimmed ? trimmed.branches.map(turned) : [];
const head = trimmed ? turned(trimmed.head) : [];
const tail = trimmed ? turned(trimmed.tail) : [];

const all = whole.flat();
const xs = all.map((p) => p[0]);
const ys = all.map((p) => p[1]);
const x0 = Math.min(...xs), x1 = Math.max(...xs);
const y0 = Math.min(...ys), y1 = Math.max(...ys);
const W = 860, PAD = 26;
const spanX = x1 - x0 || 1, spanY = y1 - y0 || 1;
const k = Math.min((W - 2 * PAD) / spanX, (W - 2 * PAD) / spanY);
const H = Math.round(spanY * k + 2 * PAD);
const px = ([x, y]) => [PAD + (x - x0) * k, H - PAD - (y - y0) * k];
const d = (points) => points.map((p, i) => `${i ? "L" : "M"}${px(p)[0].toFixed(1)},${px(p)[1].toFixed(1)}`).join("");
const cutMark = (point, label) => {
  if (!point) return "";
  const [cx, cy] = px(point);
  return `<g><circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="7" fill="#b03a2e" fill-opacity="0.9"/>` +
    `<text x="${(cx + 11).toFixed(1)}" y="${(cy - 9).toFixed(1)}" font-family="ui-monospace,Menlo,monospace" ` +
    `font-size="14" fill="#b03a2e">${label}</text></g>`;
};
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="100%">
  <rect width="${W}" height="${H}" fill="#ffffff"/>
  <text x="14" y="22" font-family="ui-monospace,Menlo,monospace" font-size="15"
    fill="#33312d">${record.uid} ${record.name} · solid = kept · dashed = the legs dropped</text>
  ${whole.map((run) => `<path d="${d(run)}" fill="none" stroke="#b8ad99" stroke-width="1.4"/>`).join("")}
  ${trimmed ? `<path d="${d(head)}" fill="none" stroke="#a06a2c" stroke-width="1.6" stroke-dasharray="7 6"/>` : ""}
  ${trimmed ? `<path d="${d(tail)}" fill="none" stroke="#a06a2c" stroke-width="1.6" stroke-dasharray="7 6"/>` : ""}
  ${kept.map((run) => `<path d="${d(run)}" fill="none" stroke="#201d18" stroke-width="2.6" stroke-linejoin="round"/>`).join("")}
  ${trimmed ? cutMark(head[head.length - 1], `t = ${range.from.text}`) : ""}
  ${trimmed ? cutMark(tail[0], `t = ${range.to.text}`) : ""}
</svg>`;

// The cut piece with the same side curves the plate draws, before it is saved.
const previewOf = () => {
  if (!trimmed) return { svg: "", runs: 0 };
  const groups = kept.map((run) => {
    const group = PLATE.pathGroup(run, {
      widthPercent: sideValues.widthPct, plus: sideValues.plus,
      minus: sideValues.minus, profile: sideValues.profile,
    });
    return group ? group.paths.slice(0, 3) : [run];
  });
  const box = frame(groups.flat());
  return {
    svg: box ? bandSvg(groups.length === 1 ? groups[0] : groups, box) : "",
    runs: kept.length,
  };
};
const preview = previewOf();
const saved = q.get("saved");
const savedUid = q.get("new");
---

<BaseLayout title="the trim desk" pageTitle="The trim desk">
  <p class="lead"><b>{record.uid}</b> {record.name} · <a href="/trim/">trim another</a> ·
    <a href={`/tune/${record.uid}`}>tune it</a>. Cut the legs off at two rational fractions of
    t: t = 0 is the first station, t = 1 the last, and the stations between the cuts are kept.
    The cut points sit exactly on the fractions; the curve between stations is the stored sample,
    so the record still says sampled. A cut adds a curve beside its parent; the parent stays.</p>

  {saved && (
    <p class="trim-saved">saved: {saved}
      {savedUid && <> · <a href={`/plates#${savedUid}`}>see {savedUid} on the plates</a> ·
        <a href={`/tune/${savedUid}`}>tune it or rename it</a></>}
    </p>
  )}
  {rangeError && <p class="trim-bad">not cut: {rangeError}</p>}

  <div class="trim-one">
    <div class="trim-figure" set:html={svg} />
    <form class="trim-form" id="trim-form">
      <input type="hidden" name="uid" value={record.uid} />
      <label>from t <input name="from" type="text" value={fromText} size="6" /></label>
      <label>to t <input name="to" type="text" value={toText} size="6" /></label>
      <label>width % <input name="widthPct" type="number" min="0.5" max="20" step="0.05" value={sideValues.widthPct} /></label>
      <label>plus <input name="plus" type="number" min="-8" max="8" step="0.05" value={sideValues.plus} /></label>
      <label>minus <input name="minus" type="number" min="-8" max="8" step="0.05" value={sideValues.minus} /></label>
      <label>profile
        <select name="profile">
          {["bow", "s", "taper"].map((name) => <option value={name} selected={sideValues.profile === name}>{name}</option>)}
        </select>
      </label>
      <label>new name <input name="name" type="text" maxlength="120" value={q.get("name") || suggested} /></label>
      <button type="submit">preview the cut</button>
      <button type="submit" id="trim-save">cut and save</button>
      <p class="trim-state" id="trim-state" role="status" aria-live="polite"></p>
      <p class="trim-note">A fraction is whole numbers, p/q, with 0 at the first station and 1 at
        the last; a decimal is refused on purpose. {trimmed
          ? `${trimmed.keptStations} stations kept, ${trimmed.droppedStations} dropped on the legs.`
          : ""}</p>
    </form>
  </div>

  <section class="trim-piece">
    <h2>The cut piece</h2>
    <div class="trim-piece-figure">
      <figure class="trim-half">
        <div set:html={preview.svg} />
        <figcaption>
          {trimmed
            ? `t ${range.from.text} → ${range.to.text} · ${preview.runs} run${preview.runs === 1 ? "" : "s"} · ${trimmed.keptStations} stations`
            : "no cut to preview"}
        </figcaption>
      </figure>
    </div>
    <p class="trim-note">Drawn with the same side curves the plate draws; the four values are the
      ones saved with the cut.</p>
  </section>
</BaseLayout>

<script>
  import "../../scripts/trim-desk.js";
</script>

<style is:global>
  .trim-one { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; align-items: start; }
  @media (max-width: 940px) { .trim-one { grid-template-columns: 1fr; } }
  .trim-figure { background: #fff; border: 1px solid #e6dccb; padding: 8px; }
  .trim-form { display: grid; gap: 8px; background: #fffdf7; border: 1px solid #e6dccb; padding: 12px; }
  .trim-form label { display: flex; justify-content: space-between; gap: 8px; align-items: baseline;
    font: 13px/1.4 ui-monospace, Menlo, monospace; }
  .trim-form input, .trim-form select { width: 10rem; padding: 2px 4px; font-size: 13px; }
  .trim-form button { width: 100%; margin: 4px 0 0; }
  .trim-state { font: 12px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .trim-note { font: 12px/1.5 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .trim-saved { background: #f3ead2; border: 1px solid #d8c69a; padding: 8px 12px;
    font: 13px/1.4 ui-monospace, Menlo, monospace; }
  .trim-bad { color: #a4322a; font: 13px/1.4 ui-monospace, Menlo, monospace; }
  .trim-piece-figure { max-width: 560px; }
  .trim-half { margin: 0; background: #fff; border: 1px solid #e6dccb; padding: 8px; }
</style>
