---
// The wonks: each one as text (no image), then its two wonkies side by side.
// "wonk" is staging: a curve renamed out of wonk-<n> has been adopted and lives on the desk.
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repoRoot } from "../lib/gallery.js";
import { prisma } from "../lib/db.js";
import HybridCard from "../components/HybridCard.astro";

const wonkyData = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "wonkies.json"), "utf8"));
const doubleData = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "doubles.json"), "utf8"));
const doubleByParent = new Map((doubleData.doubles || []).map((row) => [row.parent, row]));
const stored = await prisma.sandboxCurve.findMany();
const decisions = new Map();
for (const row of stored) {
  try { decisions.set(row.name, JSON.parse(row.data)); } catch { /* not a decision */ }
}

const decorate = (row) => {
  const decision = decisions.get(row.id) || {};
  return {
    ...row,
    curveName: String(decision.curveName || ""),
    importance: Number(decision.importance) || 0,
    decision: String(decision.decision || ""),
    placeholder: row.id,
  };
};

const pairs = new Map();
for (const row of (wonkyData.wonkies || []).map(decorate)) {
  if (!pairs.has(row.parentName)) pairs.set(row.parentName, []);
  pairs.get(row.parentName).push(row);
}
const groups = [...pairs.entries()]
  .filter(([name]) => /^wonk-\d+$/i.test(name))
  .sort((a, b) => Number(a[0].split("-")[1]) - Number(b[0].split("-")[1]))
  .map(([name, rows]) => ({
    name,
    pieces: rows
      .sort((a, b) => a.id.localeCompare(b.id))
      .map((piece) => ({ piece, double: doubleByParent.get(piece.id)
        ? decorate(doubleByParent.get(piece.id)) : null })),
  }));
---

<BaseLayout title="the wonks" pageTitle="The wonks">
  <p class="lead">
    Each wonk as text — no image — then the two pieces the 45° line <b>y = x</b> cuts from it — <b>NW</b> above the
    line, <b>SE</b> below, each stopping at the cut. The crossings are solved from the
    equation, not found by walking the drawing. Star or save a half
    and its <b>double wonky</b> (that half mirrored across y = x) appears on
    <a href="/hybrids/">the desk</a>.
    Rename a wonk and it leaves this page for the desk.
  </p>

  {groups.map((pair) => (
    <section class="wonk-pair">
      <p class="wonk-parent">
        <b>{pair.name}</b> · {pair.pieces[0].piece.crossings} crossing pairs in a half ·
        <code>{pair.pieces[0].piece.formula.plain}</code> ·
        <code>{pair.pieces[0].piece.formula.middle}</code>
      </p>
      {pair.pieces.map(({ piece, double }) => (
        <div class="wonk-pair-row">
          <div class="wonk-side">
            <p class="wonk-label">{piece.id} — the piece</p>
            <HybridCard row={piece} />
          </div>
          <div class="wonk-side">
            <p class="wonk-label">{double ? `${double.id} — the completed figure` : "no double"}</p>
            {double && <HybridCard row={double} />}
          </div>
        </div>
      ))}
    </section>
  ))}

  <script>
    import "../scripts/hybrids.js";
  </script>
</BaseLayout>

<style is:global>
  .wonk-pair { margin: 26px 0; }
  .wonk-parent { font: 15px/1.5 Georgia, serif; color: #3b2d1c; margin: 0 0 10px; }
  .wonk-pair-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 10px 0 22px; }
  .wonk-label { font: 13px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; margin: 0 0 6px; }
  @media (max-width: 900px) { .wonk-pair-row { grid-template-columns: 1fr; } }
  .wonk-seam { font: 13px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; margin: -4px 0 10px; }
  @media (max-width: 900px) { .wonk-halves { grid-template-columns: 1fr; } }
</style>
