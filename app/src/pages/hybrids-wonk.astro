---
// The wonk family: the candidates the operator named wonk-1 … wonk-28, from the database.
// Same template as /hybrids/; only the rows differ.
import { readFileSync } from "node:fs";
import path from "node:path";
import { repoRoot } from "../lib/gallery.js";
import { prisma } from "../lib/db.js";
import HybridDesk from "../components/HybridDesk.astro";

const data = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "hybrids.json"), "utf8"));
const byId = new Map((data.candidates || []).map((row) => [row.id, row]));

const rows = await prisma.sandboxCurve.findMany();
const wonk = [];
for (const stored of rows) {
  let payload = {};
  try { payload = JSON.parse(stored.data); } catch { continue; }
  const name = String(payload.curveName || "").trim();
  // staging only: a curve renamed out of wonk-<n> has been adopted and lives on the desk
  if (!/^wonk-\d+$/i.test(name)) continue;
  const candidate = byId.get(stored.name);
  if (!candidate) continue;
  wonk.push({
    ...candidate,
    curveName: name,
    importance: Number(payload.importance) || 0,
    placeholder: name,
    number: Number(name.split("-")[1]),
  });
}
wonk.sort((a, b) => a.number - b.number);

const groups = [{ title: "the wonk family — wonk-1 … wonk-28", rows: wonk }];
---

<HybridDesk
  title="the wonk family"
  lead="The candidates named wonk-1 … wonk-28, read from the database. Same cards as the hybrid desk: Save, move to notes, reject, stars and the name."
  groups={wonk.length ? groups : []}
  count={wonk.length}
/>
