---
// The 90 chosen curves as framed illuminations, A/B/C/D. Generated list:
// workbench/frames.json, written by scripts/frames_build.mjs.
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repoRoot } from "../lib/gallery.js";

const frames = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "frames.json"), "utf8"));
const plates = frames.curves || [];
const notes = frames.notes || [];

const pairs = [];
const byBase = new Map();
for (const plate of plates) {
  const base = plate.illus.replace(/-[BCD]$/, "");
  if (!byBase.has(base)) {
    byBase.set(base, { base, name: plate.name, uid: plate.uid, variants: [] });
    pairs.push(byBase.get(base));
  }
  byBase.get(base).variants.push(plate);
}
for (const pair of pairs) {
  pair.variants.sort((a, b) => "ABCD".indexOf(a.variant) - "ABCD".indexOf(b.variant));
}
---

<BaseLayout title="the frames" pageTitle="The frames: draft A">
  <Fragment slot="head">
    <style is:global>
    .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .pair{border:1px solid var(--pico-muted-border-color);background:var(--pico-card-background-color);padding:8px}
    .four{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    figure{margin:0}
    img{display:block;width:100%;height:auto;background:#fff}
    figcaption{font:11px/1.5 ui-monospace,Menlo,monospace;color:var(--pico-muted-color);margin-top:6px;word-break:break-all}
    figcaption b{color:var(--pico-color)}
    .note{color:var(--pico-muted-color);font-size:.82rem;margin:8px 0 0}
    .flagged{border-left:3px solid #c9a441;padding-left:.6rem}
    </style>
  </Fragment>

  <h1>The frames</h1>
  <p><b>{pairs.length}</b> plates, each with <b>A</b>, <b>B</b>, <b>C</b> and <b>D</b>.
    A is the note's stored offsets; B forces them on, filled; C adds the corner rule
    from the two leg directions; D is C plus a declared waist gap and the 50% centre /
    9% band. The frame is the curve repeated <i>n</i> times a side, the side being
    <i>n</i> × the chord. {notes.length} curves on <a href="/figures">/figures</a> are
    not among these and are marked <b>[NOTE]</b> below.</p>

  <div class="grid">
    {pairs.map((pair) => (
      <div class="pair">
        <div class="four">
          {pair.variants.map((plate) => (
            <figure>
              {plate.frame
                ? <a href={plate.frame} target="_blank" rel="noopener" title={`open ${plate.illus} full size`}>
                    <img src={plate.frame} alt={plate.illus} loading="lazy">
                  </a>
                : <div class="note">frame missing: run <code>node scripts/frames_build.mjs --write</code></div>}
              <figcaption><b>{plate.illus}</b> · {plate.variant}<br>{plate.name} · {plate.uid} · {plate.perSide}/side · border {plate.marginPercent}% · offsets {plate.offsets}{plate.delta !== undefined ? ` · delta ${plate.delta}° · ${plate.cornerRule}` : ""}</figcaption>
            </figure>
          ))}
        </div>
        {pair.variants[0]?.note ? <p class="note">{pair.variants[0].note}</p> : null}
      </div>
    ))}
  </div>

  <h2>[NOTE] — framed on /figures, not among the 90</h2>
  <p class="note">These have a picture and no chosen name. Move one to the top of the naming
    desk with <b>restore</b> on <a href="/finder-candidates">/finder-candidates</a>, then name it.</p>
  <div class="grid">
    {notes.map((row) => (
      <figure class="flagged">
        <a href={row.figure} target="_blank" rel="noopener" title={`open ${row.name} full size`}>
          <img src={row.figure} alt={row.name} loading="lazy">
        </a>
        <figcaption>[NOTE] <b>{row.name}</b><br>{row.uid} · {row.candidate ? "set aside" : "not named"}</figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>
