---
// The curve finder. The numbers come from the generators via
// workbench/finder.json; this page draws, labels, and stars by a stable id.
import { finderData, svgPath } from "../lib/finder.js";
import { finderSections } from "../lib/finder-sections.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

const data = await finderData();
const curves = data.curves;
const starredIds = new Set((data.starred || []).map((s) => s.id).filter(Boolean));
const starredNames = new Set((data.starred || []).map((s) => s.name).filter(Boolean));
const isStarred = (c) => starredIds.has(c.id) || starredNames.has(c.name);
const sections = finderSections(curves, isStarred);

const specs = Object.fromEntries(curves.map((c) => [c.id, {
  name: c.name, family: c.family || "other", definition: c.definition || null,
}]));

function metaLine(curve) {
  const bits = [`degree ${curve.degree}`];
  bits.push(curve.proper ? "proper" : (curve.cover ? `cover ×${curve.cover}` : "cover"));
  if (curve.note) bits.push(curve.note);
  if (curve.peak) {
    bits.push(`peak t ${curve.peak.t.toFixed(3)}`);
    bits.push(`tangent ${curve.peak.angle.toFixed(1)}°`);
    bits.push(`κ ${curve.peak.kappa.toFixed(3)}`);
  }
  const rec = curve.record || {};
  if (rec.formula) bits.push(rec.formula);
  if (rec.variables && Object.keys(rec.variables).length) {
    bits.push("vars " + Object.entries(rec.variables).map(([k, v]) => `${k}=${Array.isArray(v) ? JSON.stringify(v) : v}`).join(" "));
  }
  if (rec.grid) bits.push(`grid ${rec.grid}`);
  bits.push(rec.sandbox ? "sandbox ✓" : `sandbox ✗ (${rec.sandboxReason || "no definition"})`);
  const f = curve.features || {};
  if (f["tangent_45"] && f["tangent_45"].length) bits.push(`45° at t ${f["tangent_45"].join(", ")}`);
  if (f["tangent_-45"] && f["tangent_-45"].length) bits.push(`−45° at t ${f["tangent_-45"].join(", ")}`);
  if (f.crossing_pairs !== undefined) bits.push(`${f.crossing_pairs} crossing pairs`);
  return bits.join(" · ");
}
---

<BaseLayout title="the curve finder" pageTitle="Curve finder: draft A" mainClass="">
  <Fragment slot="head">
    <style is:global>
    body{margin:0;background:#f6f1e4;color:#2e2413;font:15px/1.55 Georgia,serif}
    main{max-width:1120px;margin:0 auto;padding:24px 22px 60px}
    h1{font-size:24px;margin:0 0 4px}
    h2{font-size:16px;margin:26px 0 2px}
    .lead{color:#8c6a21;margin:0 0 12px;font-size:13px}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
    .card{background:#fffdf7;border:1px solid #d8ccae;padding:10px}
    .card h3{font-size:14px;margin:0 0 6px}
    .card svg{display:block;width:100%;height:auto;background:#fff;border:1px solid #eee;margin-bottom:6px}
    .meta{font:11px/1.55 ui-monospace,Menlo,monospace;color:#555}
    .flag{display:inline-block;margin:4px 4px 0 0;padding:1px 6px;border:1px solid #c9a441;
      background:#fbf3dc;font:10px/1.5 ui-monospace,Menlo,monospace;color:#8c6a21}
    .star{background:none;border:0;font-size:15px;color:#8c6a21;cursor:pointer;padding:0 3px}
    #save-stars,#export-stars{font:11px ui-monospace,Menlo,monospace;padding:2px 8px;border:1px solid #c9a441;
      background:#fbf3dc;color:#8c6a21;cursor:pointer}
    #star-status{font:11px ui-monospace,Menlo,monospace;color:#7b6c4e;margin-left:8px}
    .empty{border:1px dashed #d3d3d3;padding:18px;color:#777}
    code{font:11px ui-monospace,Menlo,monospace}
    </style>
  </Fragment>
  <h1>Curve finder</h1>
  <p class="lead" id="star-status" aria-live="polite"></p>

  {sections.length ? sections.map((section) => (
    <section id={section.key}>
      <h2>{section.title}{section.key === "starred"
        ? <span id="star-count" title="stars this page can show"> {section.curves.length}</span>
        : null}</h2>
      {section.lead ? <p class="lead">{section.lead}</p> : null}
      <div class="grid" id={`${section.key}-grid`}>
        {section.curves.map((curve) => {
          const { d, viewBox } = svgPath(curve.path);
          return (
            <article class="card">
              <h3><button class="star" type="button" data-id={curve.id} aria-label={`star ${curve.name}`}>☆</button> {curve.name}</h3>
              <svg viewBox={viewBox} role="img" aria-label={curve.name}><path d={d} fill="none" stroke="#111" stroke-width="1.2"/></svg>
              <p class="meta">{metaLine(curve)}</p>
              {curve.flags && curve.flags.length ? curve.flags.map((flag) => <span class="flag">{flag}</span>) : null}
            </article>
          );
        })}
      </div>
    </section>
  )) : (
    <p class="empty">No curves yet. Run a generator, e.g. <code>.venv/bin/python scripts/septic_family.py</code>.</p>
  )}

  <script id="finder-stars-seed" type="application/json" set:html={JSON.stringify(data.starred || [])}></script>
  <script id="finder-specs" type="application/json" set:html={JSON.stringify(specs)}></script>
  <script id="finder-name-to-id" type="application/json" set:html={JSON.stringify(Object.fromEntries(curves.map((c) => [c.name, c.id])))}></script>
  <script>import "../scripts/finder-stars.js";</script>
</BaseLayout>
