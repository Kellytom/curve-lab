---
// The curve finder. The numbers come from the generators via
// workbench/finder.json; this page draws, labels, and stars by a stable id.
import { finderData, svgPath } from "../lib/finder.js";
import { finderSections } from "../lib/finder-sections.js";
import AppNav from "../components/AppNav.astro";

const data = await finderData();
const curves = data.curves;
const starredIds = new Set((data.starred || []).map((s) => s.id).filter(Boolean));
const starredNames = new Set((data.starred || []).map((s) => s.name).filter(Boolean));
const isStarred = (c) => starredIds.has(c.id) || starredNames.has(c.name);
const sections = finderSections(curves, isStarred);

const specs = Object.fromEntries(curves.map((c) => [c.id, {
  name: c.name, family: c.family || "other", definition: c.definition || null,
}]));

function metaLine(curve) {
  const bits = [`degree ${curve.degree}`];
  bits.push(curve.proper ? "proper" : (curve.cover ? `cover ×${curve.cover}` : "cover"));
  if (curve.note) bits.push(curve.note);
  if (curve.peak) {
    bits.push(`peak t ${curve.peak.t.toFixed(3)}`);
    bits.push(`tangent ${curve.peak.angle.toFixed(1)}°`);
    bits.push(`κ ${curve.peak.kappa.toFixed(3)}`);
  }
  const rec = curve.record || {};
  if (rec.formula) bits.push(rec.formula);
  if (rec.variables && Object.keys(rec.variables).length) {
    bits.push("vars " + Object.entries(rec.variables).map(([k, v]) => `${k}=${Array.isArray(v) ? JSON.stringify(v) : v}`).join(" "));
  }
  if (rec.grid) bits.push(`grid ${rec.grid}`);
  bits.push(rec.sandbox ? "sandbox ✓" : `sandbox ✗ (${rec.sandboxReason || "no definition"})`);
  const f = curve.features || {};
  if (f["tangent_45"] && f["tangent_45"].length) bits.push(`45° at t ${f["tangent_45"].join(", ")}`);
  if (f["tangent_-45"] && f["tangent_-45"].length) bits.push(`−45° at t ${f["tangent_-45"].join(", ")}`);
  if (f.crossing_pairs !== undefined) bits.push(`${f.crossing_pairs} crossing pairs`);
  return bits.join(" · ");
}
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/vendor/pico.min.css">
<link rel="stylesheet" href="/vendor/curve-lab-theme.css">
<link rel="stylesheet" href="/vendor/app-shell.css">
<title>Curve finder: draft A</title>
<style is:global>
body{margin:0;background:#f6f1e4;color:#2e2413;font:15px/1.55 Georgia,serif}
main{max-width:1120px;margin:0 auto;padding:24px 22px 60px}
h1{font-size:24px;margin:0 0 4px}
h2{font-size:16px;margin:26px 0 2px}
.lead{color:#8c6a21;margin:0 0 12px;font-size:13px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{background:#fffdf7;border:1px solid #d8ccae;padding:10px}
.card h3{font-size:14px;margin:0 0 6px}
.card svg{display:block;width:100%;height:auto;background:#fff;border:1px solid #eee;margin-bottom:6px}
.meta{font:11px/1.55 ui-monospace,Menlo,monospace;color:#555}
.flag{display:inline-block;margin:4px 4px 0 0;padding:1px 6px;border:1px solid #c9a441;
  background:#fbf3dc;font:10px/1.5 ui-monospace,Menlo,monospace;color:#8c6a21}
.star{background:none;border:0;font-size:15px;color:#8c6a21;cursor:pointer;padding:0 3px}
#save-stars,#export-stars{font:11px ui-monospace,Menlo,monospace;padding:2px 8px;border:1px solid #c9a441;
  background:#fbf3dc;color:#8c6a21;cursor:pointer}
#star-status{font:11px ui-monospace,Menlo,monospace;color:#7b6c4e;margin-left:8px}
.empty{border:1px dashed #d3d3d3;padding:18px;color:#777}
code{font:11px ui-monospace,Menlo,monospace}
</style>
</head><body>
<AppNav title="the curve finder" />
<main id="main">
<h1>Curve finder</h1>
<p class="lead" id="star-status" aria-live="polite"></p>

{sections.length ? sections.map((section) => (
  <section id={section.key}>
    <h2>{section.title}{section.key === "starred"
      ? <span id="star-count" title="stars this page can show"> {section.curves.length}</span>
      : null}</h2>
    {section.lead ? <p class="lead">{section.lead}</p> : null}
    <div class="grid" id={`${section.key}-grid`}>
      {section.curves.map((curve) => {
        const { d, viewBox } = svgPath(curve.path);
        return (
          <article class="card">
            <h3><button class="star" type="button" data-id={curve.id} aria-label={`star ${curve.name}`}>☆</button> {curve.name}</h3>
            <svg viewBox={viewBox} role="img" aria-label={curve.name}><path d={d} fill="none" stroke="#111" stroke-width="1.2"/></svg>
            <p class="meta">{metaLine(curve)}</p>
            {curve.flags && curve.flags.length ? curve.flags.map((flag) => <span class="flag">{flag}</span>) : null}
          </article>
        );
      })}
    </div>
  </section>
)) : (
  <p class="empty">No curves yet. Run a generator, e.g. <code>.venv/bin/python scripts/septic_family.py</code>.</p>
)}
</main>
<script id="finder-stars-seed" type="application/json" set:html={JSON.stringify(data.starred || [])}></script>
<script id="finder-specs" type="application/json" set:html={JSON.stringify(specs)}></script>
<script id="finder-name-to-id" type="application/json" set:html={JSON.stringify(Object.fromEntries(curves.map((c) => [c.name, c.id])))}></script>
<script>
import { dedupeStars } from "../lib/star-list.js";
(() => {
  const KEY = "finder-stars";
  let lastError = "";
  const removedStars = new Set();
  const nameToId = JSON.parse(document.getElementById("finder-name-to-id").textContent || "{}");
  const specs = JSON.parse(document.getElementById("finder-specs").textContent || "{}");
  const migrate = (list) => list.map((star) => {
    if (star.id || !star.name) return star;
    const id = nameToId[star.name];
    return id ? { ...star, id } : star;
  });
  const read = () => {
    try {
      // Seed from the file once, then this browser is the editor. Merging the
      // file into every read made a star impossible to remove: the file put it
      // back. One star per curve: the same curve starred under an old name and
      // a new one is collapsed on read, and the cleaned list is written back.
      const raw = localStorage.getItem(KEY);
      if (raw !== null) {
        const value = JSON.parse(raw);
        const stored = Array.isArray(value) ? value : [];
        const out = dedupeStars(migrate(stored), nameToId);
        if (out.length !== stored.length) localStorage.setItem(KEY, JSON.stringify(out));
        return out;
      }
      const seed = JSON.parse(document.getElementById("finder-stars-seed").textContent || "[]");
      const out = dedupeStars(migrate(seed), nameToId);
      localStorage.setItem(KEY, JSON.stringify(out));
      return out;
    } catch { return []; }
  };
  const write = (list) => localStorage.setItem(KEY, JSON.stringify(list));
  const chosen = () => {
    const list = read();
    return { ids: new Set(list.map((s) => s.id).filter(Boolean)),
             names: new Set(list.map((s) => s.name).filter(Boolean)) };
  };
  const paint = () => {
    const pick = chosen();
    document.querySelectorAll("button.star").forEach((button) => {
      const card = button.closest(".card");
      const title = (button.parentElement.textContent || "").replace("★", "").replace("☆", "").trim();
      const on = pick.ids.has(button.dataset.id) || pick.names.has(title);
      button.textContent = on ? "★" : "☆";
      // A starred card rises to the Starred grid; an unstarred one goes home.
      // Without the second half a removed star stayed at the top of the page.
      const home = card?.dataset.home && document.getElementById(card.dataset.home);
      if (on) {
        const grid = document.getElementById("starred-grid");
        if (card && grid && card.parentElement !== grid) grid.appendChild(card);
      } else if (card && home && card.parentElement !== home) {
        home.appendChild(card);
      }
    });
    const count = document.querySelectorAll("#starred-grid article.card").length;
    const lead = document.getElementById("star-count");
    if (lead) lead.textContent = ` ${count}`;
    const status = document.getElementById("star-status");
    if (status) status.textContent = lastError;
    const empty = document.getElementById("starred-empty");
    if (empty) empty.style.display = count ? "none" : "";
  };
  document.querySelectorAll("button.star").forEach((button) => {
    button.addEventListener("click", () => {
      const list = read();
      const id = button.dataset.id;
      const at = list.findIndex((s) => s.id === id);
      if (at >= 0) {
        // The server keys by name, so a removal has to name the star it drops.
        const [gone] = list.splice(at, 1);
        if (gone?.name) removedStars.add(gone.name);
      } else {
        const spec = specs[id] || {};
        list.push({ id, ...spec });
        // A pending removal of this name is cancelled: it was just starred again.
        if (spec.name) removedStars.delete(spec.name);
      }
      write(list);
      paint();
    });
  });
  // The server keys a star by its name: a name is what survives a rename, and
  // the export file the sandbox reads carries names only. A star that has an id
  // but no name gets the name from this page's own table before it is sent, so
  // the body can never be refused for a missing name.
  const forSave = () => read().map((star) => {
    const name = star.name || specs[star.id]?.name;
    if (!name) return null;
    const { id, ...rest } = star;
    return { ...rest, name };
  }).filter(Boolean);
  const post = async () => {
    const status = document.getElementById("star-status");
    try {
      const response = await fetch("/api/finder-stars", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ format: "curve-lab.finder-stars/1", curves: forSave(),
                               removed: [...removedStars] }),
      });
      const out = await response.json();
      if (response.ok) {
        lastError = "";
        removedStars.clear();
        if (status) status.textContent = "";
        return;
      }
      lastError = `save failed: ${out.error} — the stars are kept in this browser`;
      try {
        localStorage.setItem("finder-stars-rescue",
          JSON.stringify({ at: new Date().toISOString(), curves: read() }));
      } catch { /* storage may be full */ }
      status.textContent = lastError;
    } catch (error) {
      lastError = `save failed: ${error} — the stars are kept in this browser`;
      try {
        localStorage.setItem("finder-stars-rescue",
          JSON.stringify({ at: new Date().toISOString(), curves: read() }));
      } catch { /* storage may be full */ }
      status.textContent = lastError;
    }
  };
  const save = document.getElementById("save-stars");
  if (save) save.addEventListener("click", post);
  // Always saved, quietly: the file is what the sandbox reads, and a star that
  // only lives in this browser is a star the next step cannot see.
  let timer = null;
  document.querySelectorAll("button.star").forEach((button) => button.addEventListener("click", () => {
    clearTimeout(timer);
    timer = setTimeout(post, 400);
  }));
  const exportStars = document.getElementById("export-stars");
  if (exportStars) exportStars.addEventListener("click", () => {
    const blob = new Blob([JSON.stringify({ format: "curve-lab.finder-stars/1", curves: forSave() }, null, 1)],
      { type: "application/json" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = "finder-stars.json";
    link.click();
  });
  // Every card remembers the grid it was built in, so paint() can send it back
  // when its star is removed.
  document.querySelectorAll("section .grid").forEach((grid) => {
    grid.querySelectorAll("article.card").forEach((card) => { card.dataset.home = grid.id; });
  });
  paint();
})();
</script>
</body></html>
