---
// The PH nth sandbox, inside the app. One copy of the page: the generated file
// stays at /pages/ph-nth-sandbox-exp.html and this route frames it.
const SRC = "/pages/ph-nth-sandbox-exp.html";
---

<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PH nth sandbox: draft A</title>
<style is:global>
body{margin:0;background:#f6f1e4;color:#2e2413;font:14px/1.5 Georgia,serif}
header{padding:10px 18px;border-bottom:1px solid #d8ccae;background:#efe7d3;
  font:11px/1.5 ui-monospace,Menlo,monospace;color:#7b6c4e}
header a{color:#8c6a21;font-weight:600;text-decoration:none}
header a:hover{text-decoration:underline}
header .note{margin-left:8px;color:#999}
main{padding:0}
iframe{display:block;width:100%;height:calc(100vh - 42px);border:0;background:#fff}
</style>
</head><body>
<div class="draft-a" style="position:fixed;right:.75rem;bottom:.75rem;z-index:9999;background:#1b1b1b;color:#fff;font:12px/1.4 system-ui,sans-serif;padding:.35rem .6rem;border-radius:.25rem;opacity:.9">draft A</div>
<header><a href="/">the hub</a> · <a href="/finder">the curve finder</a> ·
  <a href="/lab">the lab</a> · this page is the PH nth sandbox
