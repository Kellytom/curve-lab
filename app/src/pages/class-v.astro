---
// Class V: the gothic arch from a halved Tschirnhausen. Spec: state/SPEC-class-v-int.md.
import BaseLayout from "../layouts/BaseLayout.astro";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { midSplit, nodeSplit } from "../lib/class-v.js";

// the curve as it is stored: c-0398, the Tschirnhausen. Its turn is applied, then it is cut at
// its own node, so the half is taken from the oriented curve rather than the old parameter range.
const REGISTRY = fileURLToPath(new URL("../../../workbench/curve-registry.json", import.meta.url));
const registry = JSON.parse(readFileSync(REGISTRY, "utf8"));
const record = registry.curves.find((c) => c.uid === "c-0398");
const turn = (points, degrees) => {
  const a = (-degrees * Math.PI) / 180;
  const c = Math.cos(a), s = Math.sin(a);
  return points.map(([x, y]) => ({ x: x * c - y * s, y: x * s + y * c }));
};
const full = turn(record.path.map(([x, y]) => [x, y]), Number(record.transform?.degrees || 0));
const halves = midSplit(full) || nodeSplit(full) || [];
const data = JSON.stringify({ full, halves });
---

<BaseLayout title="class V" pageTitle="Class V — the arch">
  <p class="lead">Half a Tschirnhausen, trimmed at each end and mirrored, joined at the tip:
    a pointed arch. The trim takes a share of the half's length off each end — a quarter at
    most — and the two halves meet at the top. The apex angle and the foot spread are printed
    so a row of these can be spaced without guesswork.</p>

  <div class="v-lab">
    <div id="v-preview" class="v-preview" data-curve={data}></div>
    <div class="v-controls">
      <label>trim <input id="v-trim" type="range" min="0" max="25" step="1" value="10" />
        <output id="v-trim-out">10 %</output></label>
      <label>type <select id="v-type">
        <option value="A" selected>A · slice</option>
        <option value="B">B · shortcut</option>
      </select></label>
      <label id="v-cut-row">cut before middle <input id="v-cut" type="range" min="5" max="45" step="1" value="25" />
        <output id="v-cut-out">25 %</output></label>
      <label>half <select id="v-half">
        <option value="1" selected>the second half</option>
        <option value="0">the first half</option>
      </select></label>
      <label>join <select id="v-join">
        <option value="tip">at the tip (pointed)</option>
        <option value="node">at the node (round)</option>
      </select></label>
      <label>turn <select id="v-turn">
        <option value="0">0°</option>
        <option value="90" selected>90° (legs at the bottom)</option>
        <option value="180">180°</option>
        <option value="270">270°</option>
      </select></label>
      <label>stretch y <input id="v-stretch" type="range" min="0.5" max="3" step="0.1" value="2" />
        <output id="v-stretch-out">2.0×</output></label>
      <label class="v-check"><input id="v-bandon" type="checkbox" checked /> side curves</label>
      <label>band <input id="v-band" type="range" min="0.5" max="6" step="0.1" value="2" />
        <output id="v-band-out">2.0 %</output></label>
      <label class="v-check"><input id="v-ghost" type="checkbox" checked /> show the whole Tschirnhausen</label>
      <p class="v-note" id="v-readout"></p>
    </div>
  </div>

  <h2>The first attempt, then the shortcut</h2>
  <p class="note">A fixed pair for the values above: the slice (A) first, then the shortcut (B)
    beside it. The faint dashed arch in the live panel is the same A result, kept behind B so the
    two points can be compared without moving a slider.</p>
  <div class="v-compare" id="v-compare"></div>

  <h2>Why the cut decides whether the arch is symmetric</h2>
  <ul class="v-facts">
    <li><b>Cut at the curve's own middle.</b> The half must be one exact half; anywhere else and
      the arms carry different lengths of curve.</li>
    <li><b>Trim the same share at both ends of the half.</b> An unequal slice makes one arm
      shorter, however carefully it is mirrored.</li>
    <li><b>Join on the axis.</b> The apex is the point on the mirror line; an off-axis join
      shifts the whole arch and makes one side heavier.</li>
    <li><b>Mirror, never rotate.</b> A rotation points both arms the same way; a mirror makes
      them face each other. When the four hold, left and right are the same by construction.</li>
  </ul>
</BaseLayout>

<script>
  import "../scripts/class-v-sandbox.js";
</script>

<style is:global>
  .v-lab { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 16px; align-items: start; margin: 12px 0 18px; }
  .v-preview { border: 1px solid #e6dccb; background: #fff; }
  .v-preview svg { display: block; width: 100%; height: auto; }
  .v-controls { display: grid; gap: 8px; font: 12px/1.4 ui-monospace, Menlo, monospace; }
  .v-controls label { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 3.2rem; gap: 6px; align-items: center; }
  .v-controls select { min-width: 12.5rem; }
  .v-compare { display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0 20px; }
  .v-compare figure { margin: 0; background: #fffef9; border: 1px solid #e6dccb; padding: 8px; }
  .v-compare svg { display: block; width: 320px; height: 300px; }
  .v-compare figcaption { font: 11px/1.4 ui-monospace, Menlo, monospace; color: #6b5d49; padding-top: 4px; }
  .v-facts { font-size: 14px; line-height: 1.7; max-width: 74ch; }
  .v-controls .v-check { grid-template-columns: auto 1fr; }
  .v-controls input[type="range"] { width: 100%; }
  .v-note { grid-column: 1 / -1; margin: 6px 0 0; color: #5a4a36; line-height: 1.6; }
  @media (max-width: 760px) { .v-lab { grid-template-columns: minmax(0, 1fr); } }
</style>
