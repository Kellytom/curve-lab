---
// The tuning engine: one curve, its character values, and a live preview.
// Spec: state/GRAPHICSPEC-int.md. The numbers are saved through desk-io by the form post.
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { repoRoot } from "../../lib/gallery.js";

const PLATE = (await import(path.join(repoRoot(), "workbench", "plate_math.js"))).default;
const registry = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "curve-registry.json"), "utf8"));
const { uid } = Astro.params;
const record = registry.curves.find((row) => row.uid === uid);
if (!record) return Astro.redirect("/plates/");

const q = Astro.url.searchParams;
const number = (name, fallback) => {
  const raw = q.get(name);
  return raw === null || raw === "" ? fallback : Number(raw);
};
const values = {
  widthPct: number("widthPct", record.widthPct ?? 6),
  plus: number("plus", record.plus ?? 2),
  minus: number("minus", record.minus ?? 2),
  profile: q.get("profile") || record.profile || "bow",
  degrees: number("degrees", record.transform?.degrees ?? 0),
};

const row = {
  name: record.name,
  speedX: record.speedX || [],
  speedY: record.speedY || [],
  width: { percent: values.widthPct },
  character: { plus: values.plus, minus: values.minus, profile: values.profile },
};

// the preview is the same three paths the plate uses, turned and framed here in the page
let paths = [];
let note = "";
if (row.speedX.length) {
  try {
    const group = PLATE.group(row);
    paths = group.paths.slice(0, 3);
    note = group.note;
  } catch { note = "the rows are too large for the rail routine; spine only"; }
}
if (!paths.length && record.path) { paths = [record.path]; note = "stored as a path: spine only"; }
if (values.degrees) {
  const a = (-values.degrees * Math.PI) / 180, c = Math.cos(a), s = Math.sin(a);
  paths = paths.map((line) => line.map(([x, y]) => [x * c - y * s, x * s + y * c]));
}
const all = paths.flat().filter(([x, y]) => Number.isFinite(x) && Number.isFinite(y));
if (!all.length) {
  paths = [];
}
const x0 = all.length ? Math.min(...all.map((p) => p[0])) : 0;
const x1 = all.length ? Math.max(...all.map((p) => p[0])) : 1;
const y0 = Math.min(...all.map((p) => p[1])), y1 = Math.max(...all.map((p) => p[1]));
const W = 760, H = Math.max(200, Math.round((W * (y1 - y0)) / ((x1 - x0) || 1)));
const k = (W * 0.98) / ((x1 - x0) || 1);
const ox = W / 2 - ((x0 + x1) / 2) * k, oy = H / 2 + ((y0 + y1) / 2) * k;
const toPath = (line) => line.map(([x, y]) => `${(ox + x * k).toFixed(1)},${(oy - y * k).toFixed(1)}`).join(" L");
const svg = !all.length
  ? `<p class="tune-note">No drawable points for this curve at these values.</p>`
  : paths.length >= 3
  ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">
      <rect width="${W}" height="${H}" fill="#fff"/>
      <path d="M${toPath([...paths[0], ...[...paths[1]].reverse()])}Z" fill="#e2e2e2"/>
      <path d="M${toPath([...paths[0], ...[...paths[2]].reverse()])}Z" fill="#8a8a8a"/>
      <path d="M${toPath(paths[1])}" fill="none" stroke="#3a3a3a" stroke-width="1.5"/>
      <path d="M${toPath(paths[2])}" fill="none" stroke="#3a3a3a" stroke-width="1.5"/>
      <path d="M${toPath(paths[0])}" fill="none" stroke="#2b2b2b" stroke-width="2.5"/>
    </svg>`
  : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">
      <rect width="${W}" height="${H}" fill="#fff"/>
      <path d="M${toPath(paths[0] || [])}" fill="none" stroke="#2b2b2b" stroke-width="2.5"/>
    </svg>`;
---

<BaseLayout title="the tuning engine" pageTitle="The tuning engine">
  <p class="lead"><b>{record.uid}</b> {record.name} · {note || "no rails"} · dragged by the four
    character values. The preview is the same <code>plate_math</code> the plate uses; the form
    posts the numbers to the desk and re-renders this plate.</p>

  <div class="tune-grid">
    <div class="tune-preview" set:html={svg} />
    <form class="tune-form" method="get">
      <label>width % <input name="widthPct" type="number" min="0.5" max="20" step="0.5" value={values.widthPct} /></label>
      <label>plus <input name="plus" type="number" min="-8" max="8" step="0.5" value={values.plus} /></label>
      <label>minus <input name="minus" type="number" min="-8" max="8" step="0.5" value={values.minus} /></label>
      <label>profile
        <select name="profile">
          {["bow", "s", "taper"].map((name) => <option value={name} selected={values.profile === name}>{name}</option>)}
        </select>
      </label>
      <label>turn° <input name="degrees" type="number" min="-180" max="180" step="45" value={values.degrees} /></label>
      <button type="submit">preview</button>
      <button type="submit" formaction={`/api/tune?uid=${record.uid}`} formmethod="post">save + render</button>
    </form>
  </div>
  {q.get("saved") && <p class="tune-ok">saved and rendered — <a href="/plates/">back to the plates</a></p>}
  <p class="tune-note">Save writes the four values to the row (desk-io) and runs
    <code>print_plates.mjs --only {record.uid}</code>; reload this page to see the new
    <code>book/print/{record.uid}-3000-grey-300dpi.png</code>.</p>
</BaseLayout>

<style is:global>
  .tune-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; align-items: start; }
  .tune-preview { border: 1px solid #e6dccb; background: #fff; padding: 8px; }
  .tune-preview svg { width: 100%; height: auto; display: block; }
  .tune-form label { display: flex; justify-content: space-between; gap: 8px; font: 13px/1.5 ui-monospace, Menlo, monospace; margin: 0 0 8px; }
  .tune-form input, .tune-form select { width: 7rem; margin: 0; padding: 2px 4px; font-size: 13px; }
  .tune-form button { width: 100%; margin: 6px 0 0; }
  .tune-note { font: 13px/1.5 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .tune-ok { font: 14px/1.5 ui-monospace, Menlo, monospace; color: #2f6f3a; }
</style>
