---
// The tuning page: one curve, its four values, a live preview, and the desk's saves.
// A curve can be saved over, or a new curve made beside it with a uid of its own.
// Spec: state/SPEC-tune-lab-int.md. Desk rules: app/src/lib/desk-tune.js.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { repoRoot } from "../../lib/gallery.js";
import { prisma } from "../../lib/db.js";

// plate_math.js is CommonJS and lives outside app/, so Vite's import interop hands back no
// default. require() reads it from disk as Node sees it, which is the same module the plate
// script uses. Without this the page showed "no drawable points" for every row curve.
const require = createRequire(import.meta.url);
// Read the maths fresh on every request. Node caches a required file, and a cached copy
// made the server's first paint disagree with the live redraw after a maths change: the
// band sat at the old guard's 1.5 % until the first control touch moved it to 2.29 %
// (2026-11-21). The client already fetches the file with no-cache; this makes the server
// do the same.
const plateFile = path.join(repoRoot(), "workbench", "plate_math.js");
delete require.cache[require.resolve(plateFile)];
const PLATE = require(plateFile);
const registry = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "curve-registry.json"), "utf8"));

const { uid } = Astro.params;
const record = registry.curves.find((row) => row.uid === uid);
if (!record) return Astro.redirect("/plates/");

// a variant points at the curve it was made from; the list is every curve in that family
const baseUid = String(record.params?.variantOf || record.uid);
const parse = (row) => { try { return JSON.parse(row.data) || {}; } catch { return {}; } };
const deskRows = await prisma.sandboxCurve.findMany();
const dataOf = new Map(deskRows.map((row) => [row.name, parse(row)]));
const current = dataOf.get(record.uid) || {};

const defaults = { widthPct: 6, plus: 2, minus: 2, profile: "bow" };
const q = Astro.url.searchParams;
const number = (name, fallback) => {
  const raw = q.get(name);
  return raw === null || raw === "" ? fallback : Number(raw);
};
const values = {
  widthPct: number("widthPct", current.widthPct ?? defaults.widthPct),
  plus: number("plus", current.plus ?? defaults.plus),
  minus: number("minus", current.minus ?? defaults.minus),
  profile: q.get("profile") || current.profile || defaults.profile,
  degrees: number("degrees", current.transform?.degrees ?? record.transform?.degrees ?? 0),
};

const valueOf = (curve) => {
  const data = dataOf.get(curve.uid) || {};
  return {
    widthPct: data.widthPct ?? (curve.widthPct || defaults.widthPct),
    plus: data.plus ?? (curve.plus || defaults.plus),
    minus: data.minus ?? (curve.minus || defaults.minus),
    profile: data.profile || curve.profile || defaults.profile,
    degrees: data.transform?.degrees ?? curve.transform?.degrees ?? 0,
  };
};
const variants = registry.curves
  .filter((curve) => curve.uid === baseUid || String(curve.params?.variantOf || "") === baseUid)
  .sort((a, b) => a.uid.localeCompare(b.uid))
  .map((curve) => ({ uid: curve.uid, name: curve.name, ...valueOf(curve) }));

const row = {
  name: record.name,
  speedX: record.speedX || [],
  speedY: record.speedY || [],
  width: { percent: values.widthPct },
  character: { plus: values.plus, minus: values.minus, profile: values.profile },
};

// the preview is the same three paths the plate uses, turned and framed here in the page
let paths = [];
let note = "";
if (row.speedX.length) {
  try {
    const group = PLATE.group(row);
    paths = group.paths.slice(0, 3);
    // say what the width measures, and say when the band was narrowed to stop it folding
    const cut = group.width < values.widthPct
      ? ` (asked ${values.widthPct} %, cut so the band cannot fold over itself)`
      : "";
    note = `rails: each edge ${group.width} % of the curve's size away from the spine${cut}; ` +
      `plus ${values.plus}, minus ${values.minus}, ${values.profile}`;
  } catch {
    // the rail routine declined this curve: draw the spine rather than nothing
    paths = [PLATE.spine(row.speedX, row.speedY, 400).map((s) => [s.x, s.y])];
    note = "this curve's rows could not make rails, so the plate prints the spine only";
  }
}
if (!paths.length && record.path) {
  paths = [record.path];
  note = "this curve is stored as a path, so the plate prints the spine only";
}
if (values.degrees) {
  const a = (-values.degrees * Math.PI) / 180, c = Math.cos(a), s = Math.sin(a);
  paths = paths.map((line) => line.map(([x, y]) => [x * c - y * s, x * s + y * c]));
}
const all = paths.flat().filter(([x, y]) => Number.isFinite(x) && Number.isFinite(y));
if (!all.length) {
  paths = [];
}
const x0 = all.length ? Math.min(...all.map((p) => p[0])) : 0;
const x1 = all.length ? Math.max(...all.map((p) => p[0])) : 1;
const y0 = Math.min(...all.map((p) => p[1])), y1 = Math.max(...all.map((p) => p[1]));
const W = 760, H = Math.max(200, Math.round((W * (y1 - y0)) / ((x1 - x0) || 1)));
const k = (W * 0.98) / ((x1 - x0) || 1);
const ox = W / 2 - ((x0 + x1) / 2) * k, oy = H / 2 + ((y0 + y1) / 2) * k;
const toPath = (line) => line.map(([x, y]) => `${(ox + x * k).toFixed(1)},${(oy - y * k).toFixed(1)}`).join(" L");
const svg = !all.length
  ? `<p class="tune-note">No drawable points for this curve at these values.</p>`
  : paths.length >= 3
  ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">
      <rect width="${W}" height="${H}" fill="#fff"/>
      <path d="M${toPath([...paths[0], ...[...paths[1]].reverse()])}Z" fill="#e2e2e2"/>
      <path d="M${toPath([...paths[0], ...[...paths[2]].reverse()])}Z" fill="#8a8a8a"/>
      <path d="M${toPath(paths[1])}" fill="none" stroke="#3a3a3a" stroke-width="1.5"/>
      <path d="M${toPath(paths[2])}" fill="none" stroke="#3a3a3a" stroke-width="1.5"/>
      <path d="M${toPath(paths[0])}" fill="none" stroke="#2b2b2b" stroke-width="2.5"/>
    </svg>`
  : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}">
      <rect width="${W}" height="${H}" fill="#fff"/>
      <path d="M${toPath(paths[0] || [])}" fill="none" stroke="#2b2b2b" stroke-width="2.5"/>
    </svg>`;
---

<BaseLayout title="the tuning engine" pageTitle="The tuning engine">
  <p class="lead"><b>{record.uid}</b> {record.name}{record.uid !== baseUid ? ` · variant of ${baseUid}` : ""}.
    The four values shape the two edges of the band. Saving writes the desk row and rebuilds
    that plate; saving a new curve gives it the next uid beside its parent.</p>

  {q.get("saved") && <p class="tune-ok">{q.get("saved")}. {q.get("warning") || ""}</p>}
  {q.get("error") && <p class="tune-bad">not saved: {q.get("error")}</p>}

  <div class="tune-grid">
    <div class="tune-preview" id="tune-preview" set:html={svg} />
    <form class="tune-form" id="tune-form" method="get">
      <label>new curve name <input name="curveName" type="text" maxlength="120" placeholder="euler-hook-thin" /></label>
      <label>width % <input name="widthPct" type="number" min="0.5" max="20" step="0.5" value={values.widthPct} /></label>
      <label>plus <input name="plus" type="number" min="-8" max="8" step="0.5" value={values.plus} /></label>
      <label>minus <input name="minus" type="number" min="-8" max="8" step="0.5" value={values.minus} /></label>
      <label>profile
        <select name="profile">
          {["bow", "s", "taper"].map((name) => <option value={name} selected={values.profile === name}>{name}</option>)}
        </select>
      </label>
      <label>turn° <input name="degrees" type="number" min="-180" max="180" step="45" value={values.degrees} /></label>
      <button type="submit">preview</button>
      <button type="submit" formmethod="post"
        formaction={`/api/tune?uid=${record.uid}&spine=${record.uid}&mode=overwrite`}>save</button>
      <button type="submit" formmethod="post"
        formaction={`/api/tune?uid=${record.uid}&spine=${record.uid}&mode=new`}>save as a new curve</button>
    </form>
  </div>
  <p class="tune-readout" id="tune-readout">{note}. The picture redraws as you type; the
    preview button is only for a no-JavaScript browser.</p>

  <section class="tune-versions">
    <h2>Curves from this spine</h2>
    <ul>
      {variants.map((variant) => (
        <li class:list={["tune-version", { current: variant.uid === record.uid }]}>
          <a href={`/tune/${variant.uid}`}><code>{variant.uid}</code> {variant.name}</a>
          <span class="mono">
            width {variant.widthPct} % · plus {variant.plus} · minus {variant.minus} ·
            {` ${variant.profile}`} · turn {variant.degrees}°
          </span>
          {variant.uid === record.uid && <b>this one</b>}
        </li>
      ))}
    </ul>
    <p class="tune-note">A new curve takes the next uid on this spine (<code>c-0002a</code>,
      <code>c-0002b</code>) and is drawn beside its parent on the plates page. The order is by
      uid for now; the ten stars will take over the order later.</p>
  </section>
</BaseLayout>

<script type="application/json" id="tune-curve" set:html={JSON.stringify({
  name: record.name,
  speedX: record.speedX || [],
  speedY: record.speedY || [],
  path: record.path || null,
}).replace(/</g, "\\u003c")}></script>
<script is:inline src="/api/plate-math"></script>
<script>
  import "../../scripts/tune-uid.js";
</script>

<style is:global>
  .tune-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 24px; align-items: start; }
  .tune-preview { border: 1px solid #e6dccb; background: #fff; padding: 8px; }
  .tune-preview svg { width: 100%; height: auto; display: block; }
  .tune-form label { display: flex; justify-content: space-between; gap: 8px; font: 13px/1.5 ui-monospace, Menlo, monospace; margin: 0 0 8px; }
  .tune-form input, .tune-form select { width: 8rem; margin: 0; padding: 2px 4px; font-size: 13px; }
  .tune-form button { width: 100%; margin: 6px 0 0; }
  .tune-note { font: 13px/1.5 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .tune-ok { font: 14px/1.5 ui-monospace, Menlo, monospace; color: #2f6f3a; }
  .tune-bad { font: 14px/1.5 ui-monospace, Menlo, monospace; color: #9b2c2c; }
  .tune-versions { margin: 28px 0 0; }
  .tune-versions h2 { font-size: 1rem; margin: 0 0 8px; }
  .tune-versions ul { list-style: none; margin: 0; padding: 0; }
  .tune-version { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; padding: 6px 0; border-top: 1px solid #eee3d3; }
  .tune-version .mono { font: 12px/1.5 ui-monospace, Menlo, monospace; color: #6b5b46; }
  .tune-version.current { background: #fbf6ec; }
</style>
