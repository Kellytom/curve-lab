---
// The tuning page: one curve, its four values, a live preview, and the desk's saves.
// A curve can be saved over, or a new curve made beside it with a uid of its own.
// Spec: state/SPEC-tune-lab-int.md. Desk rules: app/src/lib/desk-tune.js.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { repoRoot } from "../../lib/gallery.js";
import { prisma } from "../../lib/db.js";
import { loadRegistry } from "../../lib/registry.ts";
import { starsLabel } from "../../lib/provenance.js";
import { bandSvg, frame, widerGuide } from "../../scripts/tune-render.js";
import { candidatesFor } from "../../lib/desk-candidates.ts";

// plate_math.js is CommonJS and lives outside app/, so Vite's import interop hands back no
// default. require() reads it from disk as Node sees it, which is the same module the plate
// script uses. Without this the page showed "no drawable points" for every row curve.
const require = createRequire(import.meta.url);
// Read the maths fresh on every request. Node caches a required file, and a cached copy
// made the server's first paint disagree with the live redraw after a maths change: the
// band sat at the old guard's 1.5 % until the first control touch moved it to 2.29 %
// (2026-11-21). The client already fetches the file with no-cache; this makes the server
// do the same.
const plateFile = path.join(repoRoot(), "workbench", "plate_math.js");
delete require.cache[require.resolve(plateFile)];
const PLATE = require(plateFile);
// the registry with the database's names and ratings applied: one star value per curve
const registry = await loadRegistry();

const { uid } = Astro.params;
const record = registry.curves.find((row) => row.uid === uid);
if (!record) return Astro.redirect("/plates/");

// a variant points at the curve it was made from; the list is every curve in that family
const baseUid = String(record.params?.variantOf || record.uid);
const parse = (row) => { try { return JSON.parse(row.data) || {}; } catch { return {}; } };
const deskRows = await prisma.sandboxCurve.findMany();
const dataOf = new Map(deskRows.map((row) => [row.name, parse(row)]));
const current = dataOf.get(record.uid) || {};
// a real free name in the box, not a placeholder: the page must be saveable the moment it
// opens, and a collision inside the family is skipped before the operator sees it
const curveName = current.curveName || record.name;
const takenNames = new Set();
for (const curve of registry.curves) {
  takenNames.add(String(curve.name || "").toLowerCase());
  for (const alias of curve.aliases || []) takenNames.add(String(alias || "").toLowerCase());
}
let suggestedName = `${curveName}-v2`;
for (let n = 2; takenNames.has(suggestedName.toLowerCase()); n += 1) {
  suggestedName = `${curveName}-v${n}`;
}

const defaults = { widthPct: 1.5, plus: 2, minus: 2, profile: "bow" };
const q = Astro.url.searchParams;
const number = (name, fallback) => {
  const raw = q.get(name);
  return raw === null || raw === "" ? fallback : Number(raw);
};
const values = {
  widthPct: number("widthPct", current.widthPct ?? defaults.widthPct),
  plus: number("plus", current.plus ?? defaults.plus),
  minus: number("minus", current.minus ?? defaults.minus),
  profile: q.get("profile") || current.profile || defaults.profile,
  degrees: number("degrees", current.transform?.degrees ?? record.transform?.degrees ?? 0),
};

const valueOf = (curve) => {
  const data = dataOf.get(curve.uid) || {};
  return {
    widthPct: data.widthPct ?? (curve.widthPct || defaults.widthPct),
    plus: data.plus ?? (curve.plus || defaults.plus),
    minus: data.minus ?? (curve.minus || defaults.minus),
    profile: data.profile || curve.profile || defaults.profile,
    degrees: data.transform?.degrees ?? curve.transform?.degrees ?? 0,
  };
};
const variants = registry.curves
  .filter((curve) => curve.uid === baseUid || String(curve.params?.variantOf || "") === baseUid)
  .sort((a, b) => a.uid.localeCompare(b.uid))
  .map((curve) => ({ uid: curve.uid, name: curve.name, ...valueOf(curve) }));

const row = {
  name: record.name,
  speedX: record.speedX || [],
  speedY: record.speedY || [],
  width: { percent: values.widthPct },
  character: { plus: values.plus, minus: values.minus, profile: values.profile },
};

// the desk's turn is clockwise on screen, so the model turns the other way; one helper for the
// preview and for the strip of other kinds below it
const rotatePaths = (paths, degrees) => {
  if (!degrees) return paths;
  const a = (-degrees * Math.PI) / 180;
  const c = Math.cos(a), s = Math.sin(a);
  return paths.map((line) => line.map(([x, y]) => [x * c - y * s, x * s + y * c]));
};

// the preview is the same paths the plate uses, turned and framed here in the page. A curve
// stored in branches is drawn one group per branch: never one polyline across a jump (c-0416
// drew as fragments that way).
let groups = [];     // each entry is [spine, plusRail, minusRail] or [spine]
let paths = [];      // the flat list, for the frame and the guide
let note = "";
if (row.speedX.length) {
  try {
    const group = PLATE.group(row);
    paths = group.paths.slice(0, 3);
    groups = [paths];
    // the band is the ask, unedited; say where it folds through itself, and that the plate
    // hides the loop (2026-11-23: the inside cap is withdrawn)
    const fold = group.buckles && Number.isFinite(group.fold)
      ? ` (the rail folds through itself where the curve turns tight: fold ` +
        `${group.fold.toFixed(2)}; the plate dots the crossing and hides the loop)`
      : "";
    note = `rails: each edge ${Number(group.width).toFixed(2)} % of the curve's size away ` +
      `from the spine${fold}; plus ${values.plus}, minus ${values.minus}, ${values.profile}`;
  } catch {
    // the rail routine declined this curve: draw the spine rather than nothing
    paths = [PLATE.spine(row.speedX, row.speedY, 400).map((s) => [s.x, s.y])];
    groups = [paths];
    note = "this curve's rows could not make rails, so the plate prints the spine only";
  }
}
if (!groups.length && record.path) {
  // the plate draws the character law over every stored outline; the page must match it, and
  // one group per branch is what "match" means for a multi-branch record
  const branches = PLATE.branchesOf(record);
  const built = [];
  let folded = "";
  for (const branch of branches) {
    const group = PLATE.pathGroup(branch, {
      widthPercent: values.widthPct, plus: values.plus,
      minus: values.minus, profile: values.profile,
    });
    if (group) {
      built.push(group.paths.slice(0, 3));
      if (group.buckleNote) folded = group.buckleNote;
    } else {
      built.push([branch]);
    }
  }
  groups = built;
  paths = groups.flat();
  note = `rails from the ${record.path.length} stored points` +
    (branches.length > 1 ? ` in ${branches.length} branches` : "") +
    `: exact there, approximate between them${folded ? ` (${folded})` : ""}; ` +
    `plus ${values.plus}, minus ${values.minus}, ${values.profile}`;
}
if (values.degrees) {
  groups = groups.map((group) => rotatePaths(group, values.degrees));
  paths = groups.flat();
}
// the first paint uses the same drawing function as the live redraw, so touching a control
// changes the picture only when a value changed
const box = frame(paths);
// the first paint carries the amber guide too: a redraw with unchanged values must draw the
// same picture (the check caught the two differ; a change of values is what may change it)
const guide = box && groups.length === 1 ? widerGuide(paths) : null;
const svg = box
  ? bandSvg(groups.length === 1 ? groups[0] : groups, box, guide)
  : `<p class="tune-note">No drawable points for this curve at these values.</p>`;
if (guide) {
  note += ". The amber dashed line is the wide side at 1.5× the drawn width: a guide to judge " +
    "how far it could go, not a saved value";
}

// Candidates posted from Inkscape are desk rows whose `base_uid` is this spine and which are
// not registry records yet. They are drawn from the speed rows they were posted with, at the
// values above, so the page shows what was posted rather than a promise of it.
const candidateFigures = candidatesFor(
  deskRows, baseUid, registry.curves.map((curve) => curve.uid),
).flatMap((candidate) => {
  try {
    const group = PLATE.group({
      name: candidate.name, speedX: candidate.rows.speedX, speedY: candidate.rows.speedY,
      width: { percent: values.widthPct },
      character: { plus: values.plus, minus: values.minus, profile: values.profile },
    });
    const turned = [group.paths.slice(0, 3)].map((item) => rotatePaths(item, values.degrees));
    const candidateBox = frame(turned.flat());
    if (!candidateBox) return [];
    return [{ ...candidate, svg: bandSvg(turned[0], candidateBox) }];
  } catch {
    return [];
  }
});

// The same four values on other kinds, so one setting is checked across the collection rather
// than on one curve. The kinds come from the records (row curve, stored path, a path with
// branches, a wonk double, a polyline), never from a typed list of uids; the first curve of
// each kind that draws at these values is shown.
const kindOf = (curve) => ((curve.branches || []).length > 1
  ? "branches"
  : /^double-/i.test(curve.name || "")
    ? "wonk double"
    : Array.isArray(curve.path) && curve.path.length > 2
      ? "stored path"
      : (curve.speedX || []).length ? "row curve" : "polyline");

const figureFor = (curve, kindLabel) => {
  if (curve.uid === record.uid) return null;
  let drawnGroups = [];
  let drawn = [];
  try {
    if (Array.isArray(curve.path) && curve.path.length > 2) {
      const branches = PLATE.branchesOf ? PLATE.branchesOf(curve) : [curve.path];
      drawnGroups = branches.map((branch) => {
        const group = PLATE.pathGroup(branch, {
          widthPercent: values.widthPct, plus: values.plus,
          minus: values.minus, profile: values.profile,
        });
        return group ? group.paths.slice(0, 3) : [branch];
      });
      drawn = drawnGroups.flat();
    } else if ((curve.speedX || []).length) {
      const group = PLATE.group({
        name: curve.name, speedX: curve.speedX, speedY: curve.speedY || [],
        width: { percent: values.widthPct },
        character: { plus: values.plus, minus: values.minus, profile: values.profile },
      });
      drawnGroups = [group.paths.slice(0, 3)];
      drawn = drawnGroups[0];
    }
  } catch { drawnGroups = []; drawn = []; }
  if (!drawn.length) return null;
  const turnedGroups = drawnGroups.map((group) => rotatePaths(group, values.degrees));
  const turned = turnedGroups.flat();
  const kindBox = frame(turned);
  if (!kindBox) return null;
  // the crossings are a measured number, so the strip says whether the law reached this kind
  const crossings = turnedGroups.reduce((count, group) => count + group.slice(1, 3)
    .reduce((inner, rail) => inner + PLATE.railHoles(rail).crossings.length, 0), 0);
  return {
    uid: curve.uid, name: curve.name, kind: kindLabel,
    svg: bandSvg(turnedGroups.length === 1 ? turnedGroups[0] : turnedGroups, kindBox),
    crossings,
  };
};

const kinds = [];
const seen = new Map();
for (const curve of registry.curves) {
  if (kinds.length >= 6) break;
  const label = kindOf(curve);
  // two of the commonest kinds (a row curve, a stored path), one of the rarer ones, so the
  // strip fills its three columns and still covers every kind
  const limit = label === "row curve" || label === "stored path" ? 2 : 1;
  if ((seen.get(label) || 0) >= limit) continue;
  const figure = figureFor(curve, label);
  if (!figure) continue;
  seen.set(label, (seen.get(label) || 0) + 1);
  kinds.push(figure);
}
---

<BaseLayout title="the tuning engine" pageTitle="The tuning engine">
  <p class="lead"><b>{record.uid}</b> {record.name} · <span id="tune-stars-label">stars
    {starsLabel(record.stars)}</span>{record.uid !== baseUid ? ` · variant of ${baseUid}` : ""}.
    The four values shape the two edges of the band. Saving writes the desk row and rebuilds
    that plate; saving a new curve gives it the next uid beside its parent.</p>

  {q.get("saved") && <p class="tune-ok">{q.get("saved")}. {q.get("warning") || ""}</p>}
  {q.get("error") && <p class="tune-bad">not saved: {q.get("error")}</p>}

  <div class="tune-grid">
    <div class="tune-left">
      <div class="tune-preview" id="tune-preview" set:html={svg} />
      <p class="tune-readout" id="tune-readout">{note}. The picture redraws as you type; the
        preview button is only for a no-JavaScript browser.</p>
    </div>
    <form class="tune-form" id="tune-form" method="get">
      <div class="tune-stars" id="tune-stars" data-stars={record.stars || 0}
        role="group" aria-label="stars">
        {Array.from({ length: 10 }, (_, i) => (
          <button type="button" class:list={["star", { on: (record.stars || 0) > i }]}
            data-stars={i + 1} aria-label={`${i + 1} stars`}>★</button>
        ))}
        <button type="button" class="star-none" data-stars="0" aria-label="no stars">none</button>
      </div>
      <label>new curve name <input name="curveName" type="text" maxlength="120" value={suggestedName} /></label>
      <label>rename this curve <input name="rename" type="text" maxlength="120" value={record.name} /></label>
      <label>width % <input name="widthPct" type="number" min="0.5" max="20" step="0.05" value={values.widthPct} /></label>
      <input class="tune-slider" id="widthPct-slider" type="range" min="0.5" max="20" step="0.05"
        value={values.widthPct} aria-label="width percent" />
      <label>plus <input name="plus" type="number" min="-8" max="8" step="0.05" value={values.plus} /></label>
      <input class="tune-slider" id="plus-slider" type="range" min="-8" max="8" step="0.05"
        value={values.plus} aria-label="plus" />
      <label>minus <input name="minus" type="number" min="-8" max="8" step="0.05" value={values.minus} /></label>
      <input class="tune-slider" id="minus-slider" type="range" min="-8" max="8" step="0.05"
        value={values.minus} aria-label="minus" />
      <label>profile
        <select name="profile">
          {["bow", "s", "taper"].map((name) => <option value={name} selected={values.profile === name}>{name}</option>)}
        </select>
      </label>
      <label>turn° <input name="degrees" type="number" min="-180" max="180" step="45" value={values.degrees} /></label>
      <p class="tune-trim-row"><a id="tune-trim" data-uid={record.uid} href={`/trim/${record.uid}`}>
        cut this curve's legs off at a rational t</a> — the values beside it come with it.</p>
      <button type="submit">preview</button>
      <button type="submit" formmethod="post"
        formaction={`/api/tune?uid=${record.uid}&spine=${record.uid}&mode=overwrite`}>save</button>
      <button type="submit" formmethod="post"
        formaction={`/api/tune?uid=${record.uid}&spine=${record.uid}&mode=new`}>save as a new curve</button>
      <button type="submit" formmethod="post"
        formaction={`/api/rename-curve?uid=${record.uid}`}>rename</button>
      <p class="tune-hint">The new-curve name is for <b>save as a new curve</b>; <b>save</b> keeps
        the current name. <b>rename</b> changes this curve's name: the uid and the curve stay,
        and the old name is kept as an alias so an old link still finds it.</p>
      <p class="tune-status" id="tune-status" role="status" aria-live="polite"></p>
    </form>
  </div>

  <section class="tune-kinds">
    <h2>The same values on other kinds</h2>
    <p class="tune-note">width {values.widthPct} %, plus {values.plus}, minus {values.minus},
      {values.profile}. Each figure is drawn by the same law at the values above, so one
      setting is checked across the collection; the crossing count is measured on the rail,
      not typed.</p>
    <div class="tune-kind-grid">
      {kinds.map((figure) => (
        <figure class="tune-kind">
          <div set:html={figure.svg} />
          <figcaption>
            <a href={`/tune/${figure.uid}`}><code>{figure.uid}</code></a>
            {` · ${figure.kind} · ${figure.name} · `}
            {figure.crossings
              ? `${figure.crossings} crossing${figure.crossings === 1 ? "" : "s"}`
              : "no crossing at this width"}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="tune-versions">
    <h2>Curves from this spine</h2>
    <ul>
      {variants.map((variant) => (
        <li class:list={["tune-version", { current: variant.uid === record.uid }]}>
          <a href={`/tune/${variant.uid}`}><code>{variant.uid}</code> {variant.name}</a>
          <span class="mono">
            width {variant.widthPct} % · plus {variant.plus} · minus {variant.minus} ·
            {` ${variant.profile}`} · turn {variant.degrees}°
          </span>
          {variant.uid === record.uid && <b>this one</b>}
        </li>
      ))}
    </ul>
    <p class="tune-note">A new curve takes the next uid on this spine (<code>c-0002a</code>,
      <code>c-0002b</code>) and is drawn beside its parent on the plates page. The order is by
      uid for now; the ten stars will take over the order later.</p>
  </section>

  {candidateFigures.length > 0 && (
    <section class="tune-versions tune-candidates">
      <h2>Candidates posted from Inkscape</h2>
      <ul>
        {candidateFigures.map((candidate) => (
          <li class="tune-version">
            <figure class="tune-candidate-figure" set:html={candidate.svg} />
            <span><code>{candidate.uid}</code> {candidate.name} <b>candidate</b></span>
            <span class="mono">
              posted from {candidate.baseUid} · {candidate.origin}
              {candidate.transform?.exact ? " · exact transform" : ""}
              {candidate.savedAt ? ` · ${candidate.savedAt.slice(0, 10)}` : ""}
            </span>
            <p class="tune-note">Not a registry curve yet: it is a desk row whose
              <code>base_uid</code> is this spine, drawn at the four values above from the speed
              rows it was posted with.</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script type="application/json" id="tune-uid" set:html={JSON.stringify(record.uid)}></script>
<script type="application/json" id="tune-curve" set:html={JSON.stringify({
  name: record.name,
  speedX: record.speedX || [],
  speedY: record.speedY || [],
  path: record.path || null,
  kind: record.kind || null,
}).replace(/</g, "\\u003c")}></script>
<script is:inline src="/api/plate-math"></script>
<script>
  import "../../scripts/tune-uid.js";
  import "../../scripts/tune-trim.ts";
</script>

<style is:global>
  .tune-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 12px 16px; align-items: stretch; }
  .tune-left { display: flex; flex-direction: column; min-width: 0; }
  .tune-preview { flex: 1; display: flex; align-items: center; justify-content: center; border: 1px solid #e6dccb; background: #fff; padding: 4px; }
  .tune-preview svg { width: 100%; height: auto; display: block; }
  .tune-preview svg { width: 100%; height: auto; display: block; }
  .tune-readout { margin: 6px 0 0; }
  .tune-form label { display: flex; justify-content: space-between; gap: 8px; font: 13px/1.4 ui-monospace, Menlo, monospace; margin: 0 0 5px; }
  .tune-form input, .tune-form select { width: 8rem; margin: 0; padding: 2px 4px; font-size: 13px; }
  .tune-form button { width: 100%; margin: 4px 0 0; }
  .tune-slider { width: 100%; margin: -4px 0 6px; }
  .tune-stars { display: flex; align-items: center; gap: 2px; margin: 0 0 8px; }
  .tune-stars .star { background: none; border: 0; padding: 0 1px; margin: 0; width: auto;
    font-size: 22px; line-height: 1; color: #d8c9a8; cursor: pointer; }
  .tune-stars .star.on { color: #8a6a1f; }
  .tune-stars .star-none { background: none; border: 0; margin: 0 0 0 8px; width: auto;
    font: 12px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; cursor: pointer; }
  .tune-note { font: 13px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; margin: 4px 0 0; }
  .tune-ok { font: 14px/1.4 ui-monospace, Menlo, monospace; color: #2f6f3a; margin: 4px 0 0; }
  .tune-bad { font: 14px/1.4 ui-monospace, Menlo, monospace; color: #9b2c2c; margin: 4px 0 0; }
  .tune-hint { margin: 6px 0 0; font: 12px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .tune-status { min-height: 1.3em; margin: 4px 0 0; font: 13px/1.4 ui-monospace, Menlo, monospace; color: #7a6a55; }
  .tune-status.ok { color: #2f6f3a; }
  .tune-status.bad { color: #9b2c2c; }
  .tune-status.busy { color: #7a6a55; }
  .tune-kinds { margin: 16px 0 0; }
  .tune-kinds h2 { font-size: 1rem; margin: 0 0 4px; }
  .tune-kind-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 6px; }
  .tune-kind { margin: 0; border: 1px solid #e6dccb; background: #fff; padding: 3px; display: flex; flex-direction: column; }
  .tune-kind svg { width: 100%; height: 130px; display: block; }
  .tune-kind figcaption { margin-top: 3px; flex: 1; font: 12px/1.35 ui-monospace, Menlo, monospace; color: #6b5b46; }
  .tune-versions { margin: 14px 0 0; }
  .tune-versions h2 { font-size: 1rem; margin: 0 0 4px; }
  .tune-versions ul { list-style: none; margin: 0; padding: 0; }
  .tune-version { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; padding: 4px 0; border-top: 1px solid #eee3d3; }
  .tune-version .mono { font: 12px/1.4 ui-monospace, Menlo, monospace; color: #6b5b46; }
  .tune-version.current { background: #fbf6ec; }
  .tune-candidate-figure { flex: 0 0 120px; margin: 0; }
  .tune-candidate-figure svg { width: 120px; height: auto; display: block; }
  .tune-candidates .tune-note { flex-basis: 100%; }
  @media (max-width: 860px) {
    .tune-grid { grid-template-columns: 1fr; gap: 10px; }
    .tune-preview { flex: none; }
  }
  @media (max-width: 720px) { .tune-kind-grid { grid-template-columns: 1fr; } }
</style>
