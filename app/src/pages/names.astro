---
// The naming desk: one card per chosen curve, with an explicit Save. An edit is
// kept as a draft in this browser until it is saved, so a reload cannot lose it.
import { readFileSync } from "node:fs";
import path from "node:path";
import { loadRegistry } from "../lib/registry.ts";
import { splitName } from "../lib/name-parts.ts";
import { readDuplicates } from "../lib/duplicates.ts";
import { repoRoot } from "../lib/gallery.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const registry = await loadRegistry();
const duplicates = readDuplicates(repoRoot());

const rows = registry.curves
  .filter((curve) => !curve.candidate)
  .sort((a, b) => (b.importance || 0) - (a.importance || 0) || a.name.localeCompare(b.name))
  .map((curve) => ({
    uid: curve.uid,
    name: curve.name,
    updated: curve.updated,
    named: Boolean(curve.savedName),
    twins: duplicates.get(curve.uid) || [],
    ...splitName(curve.name, curve.family_id),
    importance: curve.importance || 0,
    lists: curve.lists.join(", "),
    starred: curve.starred,
    auto: curve.auto_named,
  }));

// Highest importance first, and a count per group: the order the next decision
// needs, not the order the registry happens to hold.
type Group = { importance: number; rows: any[]; named: number };
const groups: Group[] = [];
for (const row of rows) {
  let group = groups.find((candidate) => candidate.importance === row.importance);
  if (!group) {
    group = { importance: row.importance, rows: [], named: 0 };
    groups.push(group);
  }
  group.rows.push(row);
  if (row.named) group.named += 1;
}
const namedCount = rows.filter((row) => row.named).length;
const candidateCount = registry.curves.filter((curve) => curve.candidate).length;
---

<BaseLayout title="the naming desk" pageTitle="Naming desk: draft A">
  <Fragment slot="head">
    <style is:global>
    body{margin:0;padding:16px;background:#faf8f2;color:#222;font:13px/1.4 system-ui,sans-serif}
    h1{font-size:18px;margin:0 0 4px}
    p{color:#666;margin:0 0 12px;max-width:80ch}
    .desk{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
h2.group{font:600 13px/1.4 system-ui,sans-serif;margin:18px 0 6px;padding-bottom:3px;border-bottom:1px solid #d8ccae;color:#8c6a21}
    .row{border:1px solid #d8ccae;padding:.55rem;background:#fff}
    .row img.thumb{display:block;width:100%;height:auto;background:#fff;border:1px solid #eee;margin-bottom:.4rem}
    .who{font-size:.72rem;color:#777}
    .line{display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;margin:.25rem 0}
    .line .fixed{font:12px/1.4 ui-monospace,Menlo,monospace;color:#8c6a21}
    .line input[type=text]{width:11rem;margin:0;padding:.22rem .4rem;font:12px/1.4 ui-monospace,Menlo,monospace}
    .actions{display:flex;gap:.5rem;align-items:center;margin-top:.35rem}
    .actions button.save{font:11px/1.2 ui-monospace,Menlo,monospace;padding:3px 10px;margin:0;background:#c9a441;border:1px solid #a8832c;color:#fff;cursor:pointer}
    .actions button.to-notes{font:11px/1.2 ui-monospace,Menlo,monospace;padding:3px 8px;margin:0;background:#fff;border:1px solid #c9a441;color:#8c6a21;cursor:pointer}
    .actions button.to-notes:hover{background:#fbf7ec}
    #names-undo{position:fixed;left:50%;bottom:1rem;transform:translateX(-50%);display:flex;gap:.7rem;align-items:center;
      background:#1b1b1b;color:#fff;font:12px/1.4 system-ui,sans-serif;padding:.5rem .8rem;border-radius:.3rem;z-index:9999}
    #names-undo[hidden]{display:none}
    #names-undo button{font:11px/1.2 ui-monospace,Menlo,monospace;padding:3px 9px;margin:0;background:#c9a441;border:1px solid #a8832c;color:#fff;cursor:pointer}
    .flag{font:11px/1.3 ui-monospace,Menlo,monospace;color:#2f7d32}
    .flag.bad{color:#8a3b2a}
.dupe{display:inline-block;margin-left:.4rem;padding:0 .35rem;border:1px solid #c9a441;background:#fbf3dc;color:#8c6a21;font:10px/1.5 ui-monospace,Menlo,monospace;border-radius:2px}
    </style>
  </Fragment>
  <h1>Naming desk</h1>
  <p><b>{rows.length}</b> chosen curves, <b>{namedCount}</b> named, in{" "}
    <b>{groups.length}</b> importance groups. The prefix and postfix are fixed; type the middle and
    press <b>Save</b>. An unsaved edit stays in this browser until you save it. The
    stars are importance, 1 to 10. <a href="/finder-candidates/">{candidateCount} curves set aside</a> are not listed here.</p>

  {groups.map((group) => (
  <Fragment>
  <h2 class="group">{group.importance ? `importance ${group.importance}` : "unrated"} · {group.rows.length} {group.rows.length === 1 ? "curve" : "curves"} · {group.named} named</h2>
  <div class="desk">
  {group.rows.map((row) => (
    <div class="row" data-uid={row.uid} data-imp={row.importance} data-updated={row.updated || ""}>
      <img class="thumb" src={`/curves/${row.uid}.png`} alt={`${row.name} curve`} loading="lazy">
      <div class="who">{row.uid} · {row.lists}{row.starred ? " · starred" : ""} · now: <code class="now">{row.name}</code>{row.auto ? " · auto" : ""}<span class="saved-at">{row.updated ? ` · saved ${row.updated.slice(0, 16).replace("T", " ")}` : " · not saved yet"}</span>{row.twins.length ? <span class="dupe" title="the duplicate audit says this is the same drawing, after a mirror or a rotation">same shape: {row.twins.join(", ")}</span> : null}</div>
      <div class="line">
        <span class="fixed prefix">{row.prefix}-</span>
        <input type="text" class="core" value={row.core} placeholder={row.core ? "" : row.name} aria-label={`name for ${row.uid}`}>
        <span class="fixed postfix">{row.postfix ? `-${row.postfix}` : ""}</span>
        <span class="fixed preview"></span>
      </div>
      <div class="stars" role="group" aria-label={`importance for ${row.uid}`}>
        <span class="label">importance</span>
        {Array.from({ length: 10 }, (_, i) => (
          <button type="button" data-imp={i + 1} class={i + 1 <= row.importance ? "on" : ""}>{i + 1}</button>
        ))}
      </div>
      <div class="actions">
        <button type="button" class="save">Save</button>
        <button type="button" class="to-notes" title="move this curve out of the desk and into the pool on /finder-candidates">move to notes</button>
        <span class="flag"></span>
      </div>
    </div>
  ))}
  </div>
  </Fragment>
  ))}
  <Fragment slot="scripts">
    <script>import "../scripts/names-desk.js";</script>
  </Fragment>
</BaseLayout>
