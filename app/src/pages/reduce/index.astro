---
// The reduction index as a GALLERY: one card per over-ceiling curve — the
// picture, the name underneath, the facts, the links (operator, 2026-11-23:
// "curve pictures and the name etc. underneath").
//
// The pictures are the exact curves drawn from their own speed rows through
// 33 exact stations, joined by cubic spans (the house rule — never straight
// segments between stations), flipped to SVG's y-down only here. The census
// column (speed → 5 miss, curve units) comes from workbench/speed-fit-census.json
// — a cache: without it the cards still draw, the fact prints a dash.
import { readFileSync } from "node:fs";
import path from "node:path";
import { curvePolynomials, evaluate, fr } from "../../lib/measure.ts";
import { plainNumber } from "../../lib/plain-number.js";
import { curveThumbnail } from "../../lib/curve-thumbnail.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
const repo = path.resolve(import.meta.dirname, "../../../..");
const registry = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-registry.json"), "utf8"));
const metrics = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-analysis.json"), "utf8"));
const byUid = new Map((metrics.curves || []).map((r) => [r.uid, r]));
let census = new Map();
try {
  const data = JSON.parse(readFileSync(path.join(repo, "workbench", "speed-fit-census.json"), "utf8"));
  census = new Map((data.curves || []).map((r) => [r.uid, r]));
} catch {
  census = new Map();
}

const num = (a: { n: bigint; d: bigint }): number => Number(a.n) / Number(a.d);


// the population: position degree = 2·speed + 1, speed read from the
// TRIMMED rows (a row's length minus one). Not 2·length+1 — that +2 error is
// register 57, and it put sixty-three curves in a population they were not in.
const cards = registry.curves
  .filter((c: { speedX?: number[]; speedY?: number[] }) => c.speedX && c.speedY && c.speedY.length)
  .map((c: { uid: string; name: string; speedX: number[]; speedY: number[] }) => {
    const trimLen = (row: number[]) => {
      const r = [...row].map(Number);
      while (r.length && r[r.length - 1] === 0) r.pop();
      return r.length;
    };
    const speed = Math.max(trimLen(c.speedX), trimLen(c.speedY)) - 1;
    const fit = census.get(c.uid);
    return {
      uid: c.uid,
      name: c.name,
      degree: 2 * speed + 1,
      rail: 2 * speed - 1,
      crossings: (byUid.get(c.uid) || {}).crossings ?? 0,
      miss: fit ? (fit.max_miss as number) : null,
      size: fit ? (fit.size as number) : null,
      svg: curveThumbnail(c.speedX, c.speedY),
    };
  })
  .filter((c: { degree: number }) => c.degree > 11);
const withFit = cards.filter((c: { miss: number | null }) => c.miss != null);
const served = withFit.filter((c: { miss: number | null; size: number | null }) =>
  c.size && c.miss != null && c.miss / c.size < 0.01).length;
---
<BaseLayout title="the reduction desk" pageTitle="The reduction desk">
<div class="gallery">
  <h1>The reduction desk</h1>
  <p class="lede">
    {cards.length} curves have a <b>position degree above 11</b> — computed from
    their speed rows, not the stored field. Each card is the exact curve; the
    name and facts sit underneath, and the card opens its desk: the exact curve
    and the reduced form side by side, with the proven miss bound. The{" "}
    <b>speed → 5 miss</b> is the curve's own unit count from
    <code>reduction/speed_fit.py</code> — {served} of {withFit.length} can live
    at the ceiling by the re-fit alone; the rest need the sibling map. The new
    curves these efforts produced are on <a href="/candidates/">the candidates
    page</a> — pictures and misses, waiting for a look.
  </p>

  <div class="grid">
    {cards.map((c: {
      uid: string; name: string; degree: number; rail: number;
      crossings: number; miss: number | null; size: number | null; svg: string;
    }) => (
      <article class="card">
        <a class="pic" href={`/reduce/${c.uid}`} set:html={c.svg} />
        <h2><a href={`/reduce/${c.uid}`}>{c.name}</a></h2>
        <p class="uid">{c.uid} · {c.crossings} crossings</p>
        <p class="facts">
          degree {c.degree} · rail {c.rail}<br />
          speed → 5 miss: {c.miss == null ? "—" : `${plainNumber(c.miss)} units`}<br />
          {c.size == null ? "" : `size ${plainNumber(c.size)} units`}
        </p>
        <p class="links">
          <a href={`/reduce/${c.uid}`}>the desk</a> ·
          <a href={`/api/print-plate/${c.uid}?format=svg`}>the plate</a>
        </p>
      </article>
    ))}
  </div>
</div>
</BaseLayout>

<style is:global>
  body { background: #fffdf7; }
  .gallery {
    max-width: 1180px; margin: 0 auto; padding: 0 1.25rem 3rem;
    font: 16px/1.55 Georgia, serif; color: #3b2d1c;
  }
  .gallery h1 { font-size: 28px; margin: 18px 0 6px; }
  .lede { font-size: 15px; margin: 0 0 20px; max-width: 70ch; }
  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .card {
    border: 1px solid #e6dccb; background: #fffef9; padding: 10px 12px;
    display: flex; flex-direction: column;
  }
  .card .pic { display: block; }
  .card h2 { font-size: 16px; margin: 8px 0 2px; }
  .card h2 a { color: #3b2d1c; text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; }
  .card .uid { font: 12px ui-monospace, Menlo, monospace; color: #7a6a55; margin: 0 0 6px; }
  .card .facts { font: 12px ui-monospace, Menlo, monospace; margin: 0 0 6px; }
  .card .links { font-size: 12px; margin: auto 0 0; }
  .card .links a { color: #2f6fa8; text-decoration: underline; }
</style>
