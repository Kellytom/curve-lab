---
// The reduction desk index: the over-limit curves, linked to their desks.
import { readFileSync } from "node:fs";
import path from "node:path";
const repo = path.resolve(import.meta.dirname, "../../../..");
const registry = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-registry.json"), "utf8"));
const metrics = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-analysis.json"), "utf8"));
const byUid = new Map((metrics.curves || []).map((r) => [r.uid, r]));
const overLimit = registry.curves.filter((c) => {
  const m = byUid.get(c.uid);
  return m && m.degree >= 12;
}).map((c) => ({ uid: c.uid, name: c.name, degree: byUid.get(c.uid).degree,
                crossings: byUid.get(c.uid).crossings ?? 0 }));
overLimit.sort((a, b) => b.degree - a.degree || b.crossings - a.crossings);
---
<div style="background:#fffdf7;max-width:1180px;margin:0 auto;padding:0 1.25rem 3.5rem;font:16px/1.5 Georgia,serif;color:#3b2d1c">
<h1>Reduction desk</h1>
<p>{overLimit.length} curves sit above the degree-11 ceiling. Each links to its
reduction desk: exact vs reduced, the miss drawn, the numbers printed.</p>
<table style="border-collapse:collapse;font:13px ui-monospace,Menlo,monospace">
<tr><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">uid</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">name</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">degree</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">crossings</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">desk</th></tr>
{overLimit.map((c) => (
<tr><td style="border:1px solid #e6dccb;padding:4px 10px">{c.uid}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px">{c.name}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.degree}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.crossings}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px"><a href={`/reduce/${c.uid}`}>open desk</a></td></tr>
))}
</table>
</div>
