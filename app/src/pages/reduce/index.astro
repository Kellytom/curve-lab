---
// The reduction desk index: the over-limit curves, linked to their desks,
// with the speed-space re-fit's verdict in curve units.
//
// The census (reduction/speed_fit_census.py → workbench/speed-fit-census.json)
// fits every over-ceiling curve at speed 5 — position 11, rails 9, both gates
// legal — and states the miss at the stations in the curve's own units. The
// number is the decision: small means the curve can live at the ceiling,
// large means the shape is in the top degrees and a sibling recipe is the way.
import { readFileSync } from "node:fs";
import path from "node:path";
import { plainNumber } from "../../lib/plain-number.js";
const repo = path.resolve(import.meta.dirname, "../../../..");
const registry = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-registry.json"), "utf8"));
const metrics = JSON.parse(readFileSync(path.join(repo, "workbench", "curve-analysis.json"), "utf8"));
const byUid = new Map((metrics.curves || []).map((r) => [r.uid, r]));
const censusPath = path.join(repo, "workbench", "speed-fit-census.json");
let census = new Map();
try {
  const data = JSON.parse(readFileSync(censusPath, "utf8"));
  census = new Map((data.curves || []).map((r) => [r.uid, r]));
} catch {
  census = new Map(); // the census is a cache; the page works without it
}
// The position degree is computed from the speed rows themselves: the stored
// "degree" field changed meaning once already, so the desk derives its own.
function positionDegree(speedX, speedY) {
  const trim = (row) => { const r = [...row]; while (r.length && Number(r[r.length - 1]) === 0) r.pop(); return r.length; };
  return 2 * Math.max(trim(speedX), trim(speedY)) + 1;
}
const overLimit = registry.curves.filter((c) => c.speedX && c.speedY.length)
  .map((c) => {
    const fit = census.get(c.uid);
    return { uid: c.uid, name: c.name,
             degree: positionDegree(c.speedX, c.speedY),
             crossings: (byUid.get(c.uid) || {}).crossings ?? 0,
             speed: fit ? fit.speed_degree : null,
             size: fit ? fit.size : null,
             miss: fit ? fit.max_miss : null };
  })
  .filter((c) => c.degree > 11);
overLimit.sort((a, b) => {
  if (a.miss == null && b.miss == null) return 0;
  if (a.miss == null) return 1;
  if (b.miss == null) return -1;
  return a.miss - b.miss;
});
const withFit = overLimit.filter((c) => c.miss != null);
// the fit family: the curves the re-fit serves — small miss on a readable size
const served = withFit.filter((c) => c.size > 0 && c.miss / c.size < 0.01).length;
---
<html lang="en"><head><meta charset="utf-8"><title>Reduction desk</title></head><body>
<div style="background:#fffdf7;max-width:1180px;margin:0 auto;padding:0 1.25rem 3.5rem;font:16px/1.5 Georgia,serif;color:#3b2d1c">
<h1>Reduction desk</h1>
<p>{overLimit.length} curves have a <b>position degree above 11</b> (computed
from the speed rows, not the stored field). Their rails sit higher still — a
rail is degree 2n−1, so even a degree-7 curve has a degree-13 rail — which
makes the <b>rail</b> the harder half of the ceiling. Each curve here links to
its reduction desk: exact vs reduced, the proven miss bound drawn, the numbers
printed.</p>

<p>The <b>speed-space re-fit</b> column comes from
<code>reduction/speed_fit_census.py</code>: every curve fitted at speed 5 —
position 11 and rails 9, both gates legal — with the miss stated at the
stations in the curve's <b>own units</b>. A small number means the curve can
live at the ceiling; a large one means its shape is in the top degrees and a
sibling recipe is the way. {served} of the {withFit.length} can live at the
ceiling by the re-fit alone (miss under one per cent of the curve's size);
the rest are the sibling map's work.</p>

<table style="border-collapse:collapse;font:13px ui-monospace,Menlo,monospace">
<tr><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">uid</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">name</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">position degree</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">speed → 5 miss (units)</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">curve size (units)</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">crossings</th><th style="border:1px solid #e6dccb;padding:4px 10px;background:#f4ecdd">desk</th></tr>
{overLimit.map((c) => (
<tr><td style="border:1px solid #e6dccb;padding:4px 10px">{c.uid}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px">{c.name}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.degree}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.miss == null ? "—" : plainNumber(c.miss)}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.size == null ? "—" : plainNumber(c.size)}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px;text-align:right">{c.crossings}</td>
<td style="border:1px solid #e6dccb;padding:4px 10px"><a href={`/reduce/${c.uid}`}>open desk</a></td></tr>
))}
</table>
<p style="font-size:12px;color:#7a6a55;margin-top:10px">The miss is computed by
<code>reduction/speed_fit.py</code>: a float64 search judged in exact rational
arithmetic over the returned rows. The fit family reduces with essentially
zero miss (catenary-fit: 0); the wave, loop and lace families reject it.</p>
</div>
</body></html>
