---
// The reduction desk: the exact curve and the reduced form SIDE BY SIDE, each
// drawn as its own figure with its own facts underneath and its own links.
//
// Every number comes from exact BigInt-fraction arithmetic (measure.ts for
// the polynomials, reduction/chebyshev.ts for the truncation bound — pinned
// by tests/chebyshev.test.mjs). Only the drawing samples run through
// float64, and the page says so. The bound is a guarantee, not a fit.
//
// The desk refuses its verdict if its own checks fail: the measured miss
// over the bound, or a reduced curve collapsed to a line.
import { readFileSync } from "node:fs";
import path from "node:path";
import { curvePolynomials, evaluate, fr } from "../../lib/measure.ts";
import {
  chebTailBound,
  evalChebFloat,
  powerToChebyshev,
  substitute,
} from "../../lib/reduction/chebyshev.ts";
import { plainNumber } from "../../lib/plain-number.js";

const { uid } = Astro.params;
const repo = path.resolve(import.meta.dirname, "../../../..");
const registry = JSON.parse(
  readFileSync(path.join(repo, "workbench", "curve-registry.json"), "utf8"),
);
const index = registry.curves.findIndex((c) => c.uid === uid);
const curve = index >= 0 ? registry.curves[index] : null;
const prevUid =
  index > 0
    ? registry.curves[index - 1].uid
    : registry.curves[registry.curves.length - 1].uid;
const nextUid =
  index < registry.curves.length - 1
    ? registry.curves[index + 1].uid
    : registry.curves[0].uid;

const F = (n: bigint, d: bigint = 1n) => ({ n, d });
const num = (a: { n: bigint; d: bigint }): number => Number(a.n) / Number(a.d);

if (!curve || !curve.speedX || !curve.speedY) {
  Astro.redirect("/reduce/");
}
const name: string = curve?.name ?? uid;

// ── the exact position polynomials, straight from the speed recipes ─────────
const { x, y } = curvePolynomials(curve!.speedX, curve!.speedY);
const speedDeg = (() => {
  const trimOf = (row: Array<number | string>) => {
    const r = row.map(Number);
    while (r.length && r[r.length - 1] === 0) r.pop();
    return r.length;
  };
  return Math.max(trimOf(curve!.speedX), trimOf(curve!.speedY)) - 1;
})();
const railDeg = 2 * speedDeg - 1;
const positionDegree = Math.max(x.length - 1, y.length - 1);
const CEILING = 11;
const KEEP = 11;
const DIAL = 0.0005;
const N = 240;

// ── exact samples and the exact bounding box ────────────────────────────────
const exactX: number[] = [];
const exactY: number[] = [];
let xMin = Infinity, xMax = -Infinity, yMin = Infinity, yMax = -Infinity;
for (let k = 0; k <= N; k += 1) {
  const t = fr(BigInt(k), BigInt(N));
  const ex = num(evaluate(x, t));
  const ey = num(evaluate(y, t));
  exactX.push(ex);
  exactY.push(ey);
  xMin = Math.min(xMin, ex); xMax = Math.max(xMax, ex);
  yMin = Math.min(yMin, ey); yMax = Math.max(yMax, ey);
}
const size = Math.hypot(xMax - xMin, yMax - yMin) || 1;
const exactAspect = (xMax - xMin) / (yMax - yMin || 1e-12);

// ── the proven bound ladder: pieces 1, 2, 4 … 16, exact each time ───────────
const MAX_PIECES = 16;
let pieces = 1;
let bound = F(0n);
let met = false;
const pieceMid = (p: number, of: number) => F(BigInt(2 * p + 1), BigInt(2 * of));
const pieceHalf = (of: number) => F(1n, BigInt(2 * of));

while (pieces <= MAX_PIECES) {
  let worst = F(0n);
  for (let p = 0; p < pieces; p += 1) {
    const mid = pieceMid(p, pieces);
    const half = pieceHalf(pieces);
    const tx = chebTailBound(x, mid, half, KEEP);
    const ty = chebTailBound(y, mid, half, KEEP);
    const both = F(tx.n * ty.d + ty.n * tx.d, tx.d * ty.d);
    if (both.n * worst.d > worst.n * both.d) worst = both;
  }
  bound = worst;
  if (num(bound) / size <= DIAL) { met = true; break; }
  if (pieces === MAX_PIECES) break;
  pieces *= 2;
}
const boundShare = num(bound) / size;

// ── the reduced curve, drawn through the same stations ──────────────────────
const pieceCoeffsX = [];
const pieceCoeffsY = [];
for (let p = 0; p < pieces; p += 1) {
  const mid = pieceMid(p, pieces);
  const half = pieceHalf(pieces);
  pieceCoeffsX.push(powerToChebyshev(substitute(x, mid, half)).slice(0, KEEP + 1));
  pieceCoeffsY.push(powerToChebyshev(substitute(y, mid, half)).slice(0, KEEP + 1));
}
const reducedX: number[] = [];
const reducedY: number[] = [];
let rMinX = Infinity, rMaxX = -Infinity, rMinY = Infinity, rMaxY = -Infinity;
for (let k = 0; k <= N; k += 1) {
  const t = k / N;
  const p = Math.min(pieces - 1, Math.floor(t * pieces));
  const lo = p / pieces;
  const hi = (p + 1) / pieces;
  const u = (2 * t - lo - hi) / (hi - lo);
  const rx = evalChebFloat(pieceCoeffsX[p], u);
  const ry = evalChebFloat(pieceCoeffsY[p], u);
  reducedX.push(rx);
  reducedY.push(ry);
  rMinX = Math.min(rMinX, rx); rMaxX = Math.max(rMaxX, rx);
  rMinY = Math.min(rMinY, ry); rMaxY = Math.max(rMaxY, ry);
}

// ── the desk's own checks; it refuses the verdict when one fails ────────────
let actualMiss = 0;
for (let k = 0; k <= N; k += 1) {
  actualMiss = Math.max(
    actualMiss,
    Math.hypot(exactX[k] - reducedX[k], exactY[k] - reducedY[k]),
  );
}
const missOverBound = actualMiss > num(bound) + 1e-9;
const reducedFlat =
  Math.abs(rMaxY - rMinY) < 0.001 * (yMax - yMin) && yMax - yMin > 0.01 * size;
const refused = missOverBound || reducedFlat;

const verdict = refused
  ? missOverBound
    ? "REFUSED — the measured miss broke its own bound"
    : "REFUSED — the reduced curve collapsed to a line"
  : met
    ? "YES — the drawing fits the ceiling"
    : "NO — not at 16 pieces within one twenty-thousandth of size";

const pct = (v: number): string => `${plainNumber(v * 100)} %`;
const fmtPct = (v: number): string => (v < 1e-10 ? "≈ 0" : pct(v));
// both figures share one bounding box, so the side-by-side comparison is at
// the same scale — the point of putting them next to each other
const padX = (xMax - xMin) * 0.06 || 1;
const padY = (yMax - yMin) * 0.10 || 1;
const payload = JSON.stringify({
  exactX, exactY, reducedX, reducedY,
  bbox: [xMin - padX, yMax + padY, xMax + padX, yMin - padY],
});
---

<html lang="en"><head><meta charset="utf-8"><title>{name} · the reduction desk</title></head><body>
<div class="reduce-desk">
  <p class="reduce-crumb"><a href="/reduce/">← the reduction index</a></p>

  <h1 class="reduce-title">{name}</h1>
  <p class="reduce-sub">
    {uid} · position degree {positionDegree} · speed degree {speedDeg} ·
    rail degree {railDeg}
  </p>

  <section class:list={["reduce-verdict", { "is-bad": !met || refused }]}>
    <p class="reduce-verdict-word">{verdict}</p>
    <p class="reduce-verdict-note">
      {
        refused
          ? "The desk's own check failed, so no verdict is claimed. The fault is in the desk, not the curve — it is logged in the regressions register."
          : met
            ? `Cut into ${pieces} piece${pieces > 1 ? "s" : ""} and truncated to degree ${KEEP}, the proven miss is at most ${plainNumber(num(bound))} units on a curve of size ${plainNumber(size)} units — ${fmtPct(boundShare)} of size, under the desk's bar of ${pct(DIAL)}. The number is exact arithmetic, a proof, not a fit; accept or refuse the curve by it.`
            : `Even at ${pieces} pieces the proven miss is ${plainNumber(num(bound))} units — ${fmtPct(boundShare)} of size, over the desk's bar of ${pct(DIAL)}. Cutting the tail loses the shape, not a detail. The recipe needs the speed-space reduction or a sibling curve — truncation cannot give the ceiling.`
      }
    </p>
  </section>

  <div class="reduce-pair">
    <section class="reduce-panel">
      <h2 class="reduce-h2">The exact curve</h2>
      <div id="board-exact" class="jxgbox reduce-board"></div>
      <table class="reduce-facts">
        <tr><th>position degree</th><td>{x.length - 1} (x) · {y.length - 1} (y)</td></tr>
        <tr><th>rail degree</th><td>
          {railDeg} — {railDeg <= CEILING ? "inside" : `over`} the ceiling of {CEILING}
        </td></tr>
        <tr><th>curve ceiling</th><td>{CEILING} (four-point cubic spans)</td></tr>
        <tr><th>size</th><td>{plainNumber(size)} units</td></tr>
        <tr><th>bbox</th><td>
          x {plainNumber(xMin)} … {plainNumber(xMax)}<br />
          y {plainNumber(yMin)} … {plainNumber(yMax)}
        </td></tr>
        <tr><th>shape</th><td>
          {exactAspect > 20 ? `a wide band (${plainNumber(exactAspect)} : 1)` : "compact"}
        </td></tr>
      </table>
      <p class="reduce-links">
        <a href={`/api/print-plate/${uid}?format=svg`}>the print plate (SVG)</a> ·
        <a href={`/tune/${uid}`}>the tune desk</a> ·
        <a href={`/api/print-plate/${uid}?format=png`}>the plate (PNG)</a>
      </p>
    </section>

    <section class="reduce-panel">
      <h2 class="reduce-h2">The reduced form</h2>
      <div id="board-reduced" class="jxgbox reduce-board"></div>
      <table class="reduce-facts">
        <tr><th>degree per piece</th><td>{KEEP}</td></tr>
        <tr><th>pieces</th><td>{pieces} — as cubic spans, {pieces * 4} for the whole curve</td></tr>
        <tr><th>proven miss bound</th><td>
          {plainNumber(num(bound))} units · {fmtPct(boundShare)} of size
        </td></tr>
        <tr><th>measured miss</th><td>
          {plainNumber(actualMiss)} units · {fmtPct(actualMiss / size)} of size
        </td></tr>
        <tr><th>bbox</th><td>
          x {plainNumber(rMinX)} … {plainNumber(rMaxX)}<br />
          y {plainNumber(rMinY)} … {plainNumber(rMaxY)}
        </td></tr>
        <tr><th>desk status</th><td>
          <strong>{refused ? "refused" : "verified"}</strong>
          {refused ? " — a self-check failed; the verdict is withheld" : " — measured ≤ proven, not degenerate"}
        </td></tr>
      </table>
      <p class="reduce-links">
        <a href="/reduce/">the reduction index</a> ·
        <a href="/problems/">the problem gallery</a> ·
        <a href={`/reduce/${prevUid}`}>← {prevUid}</a> ·
        <a href={`/reduce/${nextUid}`}>{nextUid} →</a>
      </p>
    </section>
  </div>

  <section class="reduce-panel">
    <h2 class="reduce-h2">What this means</h2>
    <p class="reduce-prose">
      {
        refused
          ? "The desk caught its own fault and stopped. Fix the desk first; the curve is untouched."
          : met
            ? `The drawing reaches the ceiling: ${pieces} piece${pieces > 1 ? "s" : ""} of degree ${KEEP}, worst miss proven at ${plainNumber(num(bound))} units (${fmtPct(boundShare)} of size). As cubic spans that is ${pieces * 4} spans for the whole curve. The rail gate is separate${railDeg <= CEILING ? " and passes" : `: the recipe's rails stay at degree ${railDeg}, so the catalogue entry still needs the speed-space reduction or a sibling`}.`
            : `The shape lives in the degrees above ${KEEP} — its crossings and lobes are cut off with the tail, so the reduced drawing is not the same curve. The fix is not numerical: a sibling recipe that keeps the character at degree ${CEILING} or under.`
      }
    </p>
  </section>

  <p class="reduce-nav">
    <a href={`/reduce/${prevUid}`}>← previous desk</a> ·
    <a href={`/reduce/${nextUid}`}>next desk →</a> ·
    <a href="/reduce/">the index</a> ·
    <a href="/problems/">the problem gallery</a>
  </p>
  <p class="reduce-foot">
    The bound, the polynomials and the samples are exact BigInt fractions.
    Only the reduced form's drawing evaluation runs in float64, guarded by the
    bound. The two figures share one bounding box, so they are drawn at the
    same scale. Guard: app/tests/chebyshev.test.mjs.
  </p>
</div>
</body></html>

<style is:global>
  .reduce-desk { color: #3b2d1c; font: 16px/1.55 Georgia, serif; }
  .reduce-crumb a, .reduce-nav a { color: #2f6fa8; text-decoration: underline; font-size: 14px; }
  .reduce-title { font-size: 28px; margin: 6px 0 2px; }
  .reduce-sub { font: 13px ui-monospace, Menlo, monospace; color: #7a6a55; margin: 0 0 16px; }
  .reduce-verdict {
    border: 1px solid #e6dccb; border-left: 6px solid #1a6b3c;
    background: #f4f8f2; padding: 12px 16px; margin: 0 0 18px;
  }
  .reduce-verdict.is-bad { border-left-color: #a83232; background: #f9f2f0; }
  .reduce-verdict-word { font-size: 19px; font-weight: bold; margin: 0 0 4px; color: #1a6b3c; }
  .is-bad .reduce-verdict-word { color: #a83232; }
  .reduce-verdict-note { margin: 0; font-size: 14px; }
  .reduce-pair {
    display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 0 0 18px;
  }
  .reduce-pair > section { min-width: 0; }
  @media (max-width: 860px) { .reduce-pair { grid-template-columns: 1fr; } }
  .reduce-panel {
    border: 1px solid #e6dccb; background: #fffef9;
    padding: 14px 16px; margin: 0;
  }
  .reduce-h2 { font-size: 18px; margin: 0 0 6px; }
  .reduce-prose { font-size: 15px; margin: 0 0 8px; }
  .reduce-board { width: 100%; height: 380px; background: #fffef9; border: 1px solid #e6dccb; }
  .reduce-facts {
    border-collapse: collapse; font: 13px ui-monospace, Menlo, monospace;
    width: 100%; margin-top: 10px; table-layout: fixed;
  }
  .reduce-facts th, .reduce-facts td {
    border: 1px solid #e6dccb; padding: 4px 8px; text-align: left; vertical-align: top;
    overflow-wrap: anywhere;
  }
  .reduce-facts th { background: #f4ecdd; white-space: nowrap; width: 34%; }
  .reduce-links { font-size: 13px; margin: 10px 0 0; }
  .reduce-links a { color: #2f6fa8; text-decoration: underline; }
  .reduce-foot { font-size: 12px; color: #7a6a55; margin-top: 10px; }
</style>

<Fragment slot="scripts">
  <script is:inline src="/vendor/jsxgraph/jsxgraphcore.js"></script>
  <script define:vars={{ payload }}>
    const data = JSON.parse(payload);
    if (window.JXG) {
      const makeBoard = (hostId, caption) => {
        const board = JXG.JSXGraph.initBoard(hostId, {
          boundingbox: data.bbox,
          axis: true, showCopyright: false, showNavigation: false,
          keepaspectratio: false,
          defaultAxes: {
            strokeColor: "#b9a98a",
            ticks: { strokeColor: "#b9a98a", fontSize: 9 },
          },
        });
        // the figure label inside the figure, per the house rule
        const bb = board.getBoundingBox();
        board.create("text", [
          bb[0] + (bb[2] - bb[0]) * 0.02,
          bb[1] - (bb[1] - bb[3]) * 0.04,
          caption,
        ], { fontSize: 12, strokeColor: "#3b2d1c", fixed: true, highlight: false });
        return board;
      };
      const exactBoard = makeBoard("board-exact", "exact curve");
      exactBoard.create("curve", [data.exactX, data.exactY], {
        strokeColor: "#141414", strokeWidth: 2.4, highlight: false, fixed: true,
      });
      const reducedBoard = makeBoard("board-reduced", "reduced · degree 11 per piece");
      reducedBoard.create("curve", [data.reducedX, data.reducedY], {
        strokeColor: "#1a8a3c", strokeWidth: 2.0, dash: 2, highlight: false, fixed: true,
      });
    }
  </script>
</Fragment>
