---
// The reduction desk: one curve, exact against reduced, with a PROVEN bound.
//
// Every number in the table comes from exact BigInt-fraction arithmetic
// (`measure.ts` for the position polynomials, `reduction/chebyshev.ts` for
// the truncation bound — the same basis change the Python core does, pinned
// by tests/chebyshev.test.mjs). Only the DRAWING samples run through float64,
// and the page says so. The bound is a guarantee, not a fit: the sum of the
// discarded Chebyshev coefficients' absolute values is never smaller than
// the worst miss on the piece.
//
// The desk refuses its verdict if its own checks fail: measured miss over
// the bound, or a reduced curve that collapsed to a line.
import { readFileSync } from "node:fs";
import path from "node:path";
import { curvePolynomials, evaluate, fr } from "../../lib/measure.ts";
import {
  chebTailBound,
  evalChebFloat,
  powerToChebyshev,
  substitute,
} from "../../lib/reduction/chebyshev.ts";
import { plainNumber } from "../../lib/plain-number.js";

const { uid } = Astro.params;
const repo = path.resolve(import.meta.dirname, "../../../..");
const registry = JSON.parse(
  readFileSync(path.join(repo, "workbench", "curve-registry.json"), "utf8"),
);
const index = registry.curves.findIndex((c) => c.uid === uid);
const curve = index >= 0 ? registry.curves[index] : null;
const prevUid =
  index > 0
    ? registry.curves[index - 1].uid
    : registry.curves[registry.curves.length - 1].uid;
const nextUid =
  index < registry.curves.length - 1
    ? registry.curves[index + 1].uid
    : registry.curves[0].uid;

const F = (n: bigint, d: bigint = 1n) => ({ n, d });
const num = (a: { n: bigint; d: bigint }): number => Number(a.n) / Number(a.d);

if (!curve || !curve.speedX || !curve.speedY) {
  Astro.redirect("/reduce/");
}
const name: string = curve?.name ?? uid;

// ── the exact position polynomials, straight from the speed recipes ─────────
const { x, y } = curvePolynomials(curve!.speedX, curve!.speedY);
const speedRows = curve!.speedX.map(Number);
const speedDeg = (() => {
  const trim = [...curve!.speedY.map(Number)];
  while (trim.length && trim[trim.length - 1] === 0) trim.pop();
  const tx = [...curve!.speedX.map(Number)];
  while (tx.length && tx[tx.length - 1] === 0) tx.pop();
  return Math.max(tx.length - 1, trim.length - 1);
})();
const railDeg = 2 * speedDeg - 1;
const positionDegree = Math.max(x.length - 1, y.length - 1);
const CEILING = 11; // four-point cubic spans
const KEEP = 11; // the reduced form's degree per piece
const DIAL = 0.0005; // 0.05 % of the curve's own size
const N = 240; // drawing stations

// ── exact samples and the exact bounding box ────────────────────────────────
const exactX: number[] = [];
const exactY: number[] = [];
let xMin = Infinity, xMax = -Infinity, yMin = Infinity, yMax = -Infinity;
for (let k = 0; k <= N; k += 1) {
  const t = fr(BigInt(k), BigInt(N));
  const ex = num(evaluate(x, t));
  const ey = num(evaluate(y, t));
  exactX.push(ex);
  exactY.push(ey);
  xMin = Math.min(xMin, ex); xMax = Math.max(xMax, ex);
  yMin = Math.min(yMin, ey); yMax = Math.max(yMax, ey);
}
const size = Math.hypot(xMax - xMin, yMax - yMin) || 1;
const exactAspect = (xMax - xMin) / (yMax - yMin || 1e-12);

// ── the proven bound ladder: pieces 1, 2, 4 … 16, exact each time ───────────
const MAX_PIECES = 16;
let pieces = 1;
let bound = F(0n); // max over pieces of (tailX + tailY), exact
let met = false;
const pieceMid = (p: number, of: number) =>
  F(BigInt(2 * p + 1), BigInt(2 * of));
const pieceHalf = (of: number) => F(1n, BigInt(2 * of));

while (pieces <= MAX_PIECES) {
  let worst = F(0n);
  for (let p = 0; p < pieces; p += 1) {
    const mid = pieceMid(p, pieces);
    const half = pieceHalf(pieces);
    const tx = chebTailBound(x, mid, half, KEEP);
    const ty = chebTailBound(y, mid, half, KEEP);
    const both = F(tx.n * ty.d + ty.n * tx.d, tx.d * ty.d);
    if (both.n * worst.d > worst.n * both.d) worst = both;
  }
  bound = worst;
  if (num(bound) / size <= DIAL) { met = true; break; }
  if (pieces === MAX_PIECES) break;
  pieces *= 2;
}
const boundShare = num(bound) / size;

// ── the reduced curve, drawn through the same stations ──────────────────────
const pieceCoeffsX = [];
const pieceCoeffsY = [];
for (let p = 0; p < pieces; p += 1) {
  const mid = pieceMid(p, pieces);
  const half = pieceHalf(pieces);
  pieceCoeffsX.push(powerToChebyshev(substitute(x, mid, half)).slice(0, KEEP + 1));
  pieceCoeffsY.push(powerToChebyshev(substitute(y, mid, half)).slice(0, KEEP + 1));
}
const reducedX: number[] = [];
const reducedY: number[] = [];
let rMinX = Infinity, rMaxX = -Infinity, rMinY = Infinity, rMaxY = -Infinity;
for (let k = 0; k <= N; k += 1) {
  const t = k / N;
  const p = Math.min(pieces - 1, Math.floor(t * pieces));
  const lo = p / pieces;
  const hi = (p + 1) / pieces;
  const u = (2 * t - lo - hi) / (hi - lo);
  const rx = evalChebFloat(pieceCoeffsX[p], u);
  const ry = evalChebFloat(pieceCoeffsY[p], u);
  reducedX.push(rx);
  reducedY.push(ry);
  rMinX = Math.min(rMinX, rx); rMaxX = Math.max(rMaxX, rx);
  rMinY = Math.min(rMinY, ry); rMaxY = Math.max(rMaxY, ry);
}

// ── the desk's own checks; it refuses the verdict when one fails ────────────
let actualMiss = 0;
for (let k = 0; k <= N; k += 1) {
  actualMiss = Math.max(
    actualMiss,
    Math.hypot(exactX[k] - reducedX[k], exactY[k] - reducedY[k]),
  );
}
const actualShare = actualMiss / size;
const missOverBound = actualMiss > num(bound) + 1e-9;
const reducedFlat =
  Math.abs(rMaxY - rMinY) < 0.001 * (yMax - yMin) &&
  yMax - yMin > 0.01 * size;
const refused = missOverBound || reducedFlat;

const verdict = refused
  ? missOverBound
    ? "REFUSED — the measured miss broke its own bound"
    : "REFUSED — the reduced curve collapsed to a line"
  : met
    ? "YES — the drawing fits the ceiling"
    : "NO — not at 16 pieces within one twenty-thousandth of size";

const pct = (v: number): string => `${plainNumber(v * 100)} %`;
const fmtPct = (v: number): string => (v < 1e-10 ? "≈ 0" : pct(v));
const payload = JSON.stringify({
  exactX, exactY, reducedX, reducedY,
  xMin, xMax, yMin, yMax,
});
---

<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>{name} · the reduction desk</title></head><body>
<div class="reduce-desk">
  <p class="reduce-crumb"><a href="/reduce/">← the reduction index</a></p>

  <h1 class="reduce-title">{name}</h1>
  <p class="reduce-sub">
    {uid} · position degree {positionDegree} · speed degree {speedDeg} ·
    rail degree {railDeg}
  </p>

  <section class:list={["reduce-verdict", { "is-bad": !met || refused }]}>
    <p class="reduce-verdict-word">{verdict}</p>
    <p class="reduce-verdict-note">
      {
        refused
          ? "The desk's own check failed, so no verdict is claimed. The fault is in the desk, not the curve — it is logged in the regressions register."
          : met
            ? `Cut into ${pieces} piece${pieces > 1 ? "s" : ""} and truncated to degree ${KEEP}, the proven miss is at most ${plainNumber(num(bound))} units on a curve of size ${plainNumber(size)} units — ${fmtPct(boundShare)} of size, under the desk's bar of ${pct(DIAL)}. The number is exact arithmetic, a proof, not a fit; accept or refuse the curve by it.`
            : `Even at ${pieces} pieces the proven miss is ${plainNumber(num(bound))} units — ${fmtPct(boundShare)} of size, over the desk's bar of ${pct(DIAL)}. Cutting the tail loses the shape, not a detail. The recipe needs the speed-space reduction or a sibling curve — truncation cannot give the ceiling.`
      }
    </p>
  </section>

  <section class="reduce-panel">
    <h2 class="reduce-h2">The graph</h2>
    <p class="reduce-note">
      The exact curve in black; the reduced degree-{KEEP} form in green dashed,
      through the same {N + 1} stations. Where they coincide you see only
      black. The drawing between stations is approximate.
      {
        exactAspect > 20
          ? ` The exact curve is a wide band — ${plainNumber(xMax - xMin)} wide by ${plainNumber(yMax - yMin)} tall. The board stretches the y axis to fill the frame, so the band looks tall here; the bbox row below is the true shape.`
          : ""
      }
    </p>
    <div id="reduce-board" class="jxgbox reduce-board"></div>
  </section>

  <section class="reduce-panel">
    <h2 class="reduce-h2">The numbers</h2>
    <table class="reduce-table">
      <thead><tr><th>measure</th><th>value</th><th>what it means</th></tr></thead>
      <tbody>
        <tr>
          <td>position degree</td>
          <td>{x.length - 1} (x) · {y.length - 1} (y)</td>
          <td>the exact curve's polynomial degrees</td>
        </tr>
        <tr>
          <td>curve ceiling</td>
          <td>{CEILING}</td>
          <td>what four-point cubic spans carry</td>
        </tr>
        <tr>
          <td>rail degree</td>
          <td>{railDeg}</td>
          <td>
            {railDeg <= CEILING
              ? "inside the ceiling — the rails are fine"
              : `over the ceiling of ${CEILING} — truncation cannot fix the rails; the speed-space reduction or a sibling recipe must`}
          </td>
        </tr>
        <tr>
          <td>pieces</td>
          <td>{pieces}</td>
          <td>how many segments the reduced form uses</td>
        </tr>
        <tr>
          <td>proven miss bound</td>
          <td>{plainNumber(num(bound))} units · {fmtPct(boundShare)} of size</td>
          <td>exact fractions: the sum of the discarded Chebyshev coefficients</td>
        </tr>
        <tr>
          <td>measured miss</td>
          <td>{plainNumber(actualMiss)} units · {fmtPct(actualShare)} of size</td>
          <td>at the {N + 1} stations; must stay ≤ the bound</td>
        </tr>
        <tr>
          <td>desk's bar</td>
          <td>{pct(DIAL)} of size</td>
          <td>the working bar for the default verdict; the number to judge by is the miss in units above</td>
        </tr>
        <tr>
          <td>exact bbox</td>
          <td>
            x {plainNumber(xMin)} … {plainNumber(xMax)}<br />
            y {plainNumber(yMin)} … {plainNumber(yMax)}
          </td>
          <td>size {plainNumber(size)} units</td>
        </tr>
        <tr>
          <td>reduced bbox</td>
          <td>
            x {plainNumber(rMinX)} … {plainNumber(rMaxX)}<br />
            y {plainNumber(rMinY)} … {plainNumber(rMaxY)}
          </td>
          <td>
            {reducedFlat
              ? "collapsed flat — the desk refuses"
              : "same extent as the exact curve"}
          </td>
        </tr>
        <tr>
          <td>desk status</td>
          <td><strong>{refused ? "refused" : "verified"}</strong></td>
          <td>
            {refused
              ? "a self-check failed; the verdict above is withheld"
              : "measured miss ≤ proven bound, reduced form not degenerate"}
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="reduce-panel">
    <h2 class="reduce-h2">What this means</h2>
    <p class="reduce-prose">
      {
        refused
          ? "The desk caught its own fault and stopped. Fix the desk first; the curve is untouched."
          : met
            ? `The drawing reaches the ceiling: ${pieces} piece${pieces > 1 ? "s" : ""} of degree ${KEEP}, worst miss proven at ${plainNumber(num(bound))} units (${fmtPct(boundShare)} of size). As cubic spans that is ${pieces * 4} spans for the whole curve. The rail gate is separate${railDeg <= CEILING ? " and passes" : `: the recipe's rails stay at degree ${railDeg}, so the catalogue entry still needs the speed-space reduction or a sibling`}.`
            : `The shape lives in the degrees above ${KEEP} — its crossings and lobes are cut off with the tail, so the reduced drawing is not the same curve. The fix is not numerical: a sibling recipe that keeps the character at degree ${CEILING} or under.`
      }
    </p>
  </section>

  <p class="reduce-nav">
    <a href={`/reduce/${prevUid}`}>← previous</a> ·
    <a href={`/reduce/${nextUid}`}>next →</a> ·
    <a href="/problems/">the problem gallery</a>
  </p>
  <p class="reduce-foot">
    The bound, the polynomials and the samples are exact BigInt fractions.
    Only the reduced form's drawing evaluation runs in float64, guarded by the
    bound. Spec: the reduction desk section of the plan; guard:
    app/tests/chebyshev.test.mjs.
  </p>
</div>
</body></html>

<style is:global>
  .reduce-desk { color: #3b2d1c; font: 16px/1.55 Georgia, serif; }
  .reduce-crumb a, .reduce-nav a {
    color: #2f6fa8; text-decoration: underline; font-size: 14px;
  }
  .reduce-title { font-size: 28px; margin: 6px 0 2px; }
  .reduce-sub {
    font: 13px ui-monospace, Menlo, monospace; color: #7a6a55; margin: 0 0 16px;
  }
  .reduce-verdict {
    border: 1px solid #e6dccb; border-left: 6px solid #1a6b3c;
    background: #f4f8f2; padding: 12px 16px; margin: 0 0 18px;
  }
  .reduce-verdict.is-bad {
    border-left-color: #a83232; background: #f9f2f0;
  }
  .reduce-verdict-word {
    font-size: 19px; font-weight: bold; margin: 0 0 4px; color: #1a6b3c;
  }
  .is-bad .reduce-verdict-word { color: #a83232; }
  .reduce-verdict-note { margin: 0; font-size: 14px; }
  .reduce-panel {
    border: 1px solid #e6dccb; background: #fffef9;
    padding: 14px 16px; margin: 0 0 18px;
  }
  .reduce-h2 { font-size: 18px; margin: 0 0 6px; }
  .reduce-note, .reduce-prose { font-size: 14px; margin: 0 0 8px; }
  .reduce-prose { font-size: 15px; }
  .reduce-board {
    width: 100%; height: 420px; background: #fffef9;
    border: 1px solid #e6dccb;
  }
  .reduce-table {
    border-collapse: collapse; font: 13px ui-monospace, Menlo, monospace;
    width: 100%;
  }
  .reduce-table th, .reduce-table td {
    border: 1px solid #e6dccb; padding: 5px 10px;
    text-align: left; vertical-align: top;
  }
  .reduce-table th { background: #f4ecdd; }
  .reduce-table td:first-child { white-space: nowrap; }
  .reduce-foot { font-size: 12px; color: #7a6a55; margin-top: 10px; }
</style>

<Fragment slot="scripts">
  <script is:inline src="/vendor/jsxgraph/jsxgraphcore.js"></script>
  <script define:vars={{ payload }}>
    const data = JSON.parse(payload);
    if (window.JXG) {
      const padX = (data.xMax - data.xMin) * 0.05 || 1;
      const padY = (data.yMax - data.yMin) * 0.08 || 1;
      const board = JXG.JSXGraph.initBoard("reduce-board", {
        boundingbox: [
          data.xMin - padX, data.yMax + padY,
          data.xMax + padX, data.yMin - padY,
        ],
        axis: true, showCopyright: false, showNavigation: true,
        keepaspectratio: false,
        defaultAxes: {
          strokeColor: "#b9a98a",
          ticks: { strokeColor: "#b9a98a", fontSize: 10 },
        },
      });
      board.create("curve", [data.exactX, data.exactY], {
        strokeColor: "#141414", strokeWidth: 2.4,
        highlight: false, fixed: true,
      });
      board.create("curve", [data.reducedX, data.reducedY], {
        strokeColor: "#1a8a3c", strokeWidth: 1.8, dash: 2,
        highlight: false, fixed: true,
      });
      const lx = data.xMin + (data.xMax - data.xMin) * 0.02;
      const ly = data.yMax;
      board.create("text", [lx, ly, "black: exact · green dashed: reduced (degree 11 per piece)"], {
        fontSize: 13, strokeColor: "#3b2d1c", fixed: true, highlight: false,
      });
    }
  </script>
</Fragment>
