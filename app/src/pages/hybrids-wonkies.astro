---
// The wonkies: each wonk as text, then its two halves side by side.
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { repoRoot } from "../lib/gallery.js";
import { prisma } from "../lib/db.js";
import HybridCard from "../components/HybridCard.astro";

const data = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "wonkies.json"), "utf8"));
const stored = await prisma.sandboxCurve.findMany();
const decisions = new Map();
for (const row of stored) {
  try { decisions.set(row.name, JSON.parse(row.data)); } catch { /* not a decision */ }
}

const decorate = (row) => {
  const decision = decisions.get(row.id) || {};
  return {
    ...row,
    curveName: String(decision.curveName || ""),
    importance: Number(decision.importance) || 0,
    decision: String(decision.decision || ""),
    placeholder: row.id,
  };
};

const pairs = new Map();
for (const row of (data.wonkies || []).map(decorate)) {
  if (row.decision === "saved" || row.curveName) continue;   // recovered: it is on the desk
  const key = row.parentName;
  if (!pairs.has(key)) pairs.set(key, { name: key, rows: [] });
  pairs.get(key).rows.push(row);
}
const groups = [...pairs.values()]
  .sort((a, b) => Number(a.name.split("-")[1]) - Number(b.name.split("-")[1]))
  .map((pair) => ({
    ...pair,
    rows: pair.rows.sort((a, b) => (a.half === "upper" ? -1 : 1)),
  }));
---

<BaseLayout title="the wonkies" pageTitle="The wonkies">
  <p class="lead">
    Every wonk as text — no image — then its two halves side by side: the <b>upper</b> half on
    the left, the <b>lower</b> half on the right. The stations either side of the cut are
    exact; the cut point sits on the drawn line between them. Star, name, save or reject each
    half as on the desk.
  </p>

  {groups.map((pair) => (
    <section class="wonk-pair">
      <p class="wonk-parent">
        <b>{pair.name}</b> · {pair.rows[0].crossings} crossing pairs in this half ·
        <code>{pair.rows[0].formula.plain}</code> ·
        <code>{pair.rows[0].formula.middle}</code>
      </p>
      <div class="wonk-halves">
        {pair.rows.map((row) => <HybridCard row={row} />)}
      </div>
    </section>
  ))}

  <script>
    import "../scripts/hybrids.js";
  </script>
</BaseLayout>

<style is:global>
  .wonk-pair { margin: 26px 0; }
  .wonk-parent { font: 15px/1.5 Georgia, serif; color: #3b2d1c; margin: 0 0 10px; }
  .wonk-halves { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 900px) { .wonk-halves { grid-template-columns: 1fr; } }
</style>
