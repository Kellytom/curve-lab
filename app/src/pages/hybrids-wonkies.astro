---
// The wonkies: two halves of every wonk, cut at the x axis. Same cards as the desk.
import { readFileSync } from "node:fs";
import path from "node:path";
import { repoRoot } from "../lib/gallery.js";
import { prisma } from "../lib/db.js";
import HybridDesk from "../components/HybridDesk.astro";

const data = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "wonkies.json"), "utf8"));
const stored = await prisma.sandboxCurve.findMany();
const decisions = new Map();
for (const row of stored) {
  try { decisions.set(row.name, JSON.parse(row.data)); } catch { /* not a decision */ }
}

const rows = (data.wonkies || []).map((row) => {
  const decision = decisions.get(row.id) || {};
  return {
    ...row,
    curveName: String(decision.curveName || ""),
    importance: Number(decision.importance) || 0,
    placeholder: row.id,
  };
});

const groups = [
  { title: "the wonkies — upper halves", rows: rows.filter((row) => row.half === "upper") },
  { title: "the wonkies — lower halves", rows: rows.filter((row) => row.half === "lower") },
];
---

<HybridDesk
  title="the wonkies"
  lead="Two halves of every wonk, cut where it crosses the x axis: an upper half and a lower half. The stations either side of the cut are exact; the cut point itself is on the drawn line between them. Save, star, name or reject as on the desk."
  groups={groups}
  count={rows.length}
/>
