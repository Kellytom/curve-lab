---
// The print plates: every curve in one list, each with a thumbnail and a link to its plate.
// A plate is 300 dpi, white ground, turned as the record says, in two greys.
import { existsSync, readFileSync, statSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadRegistry } from "../lib/registry.ts";
import { repoRoot } from "../lib/gallery.js";
import { isKept, provenanceFor } from "../lib/provenance.js";
import { orderPlates } from "../lib/plate-order.js";

const registry = await loadRegistry();
const print = path.join(repoRoot(), "book", "print");
const byUid = new Map(registry.curves.map((curve) => [curve.uid, curve]));
const order = Astro.url.searchParams.get("order") === "uid" ? "uid" : "stars";
const rows = orderPlates(registry.curves.filter((curve) => isKept(curve, byUid)), order)
  .map((curve) => ({
    uid: curve.uid,
    name: curve.name,
    provenance: provenanceFor(curve, byUid),
    formula: curve.formula?.plain || "",
    turn: curve.transform?.degrees || 0,
    exported: existsSync(path.join(print, `${curve.uid}-3000-grey-300dpi.png`)),
    web: existsSync(path.join(repoRoot(), "app", "public", "plates-web", `${curve.uid}-1600-grey.png`)),
    // the web copy is re-rendered by the tuning page; the stamp makes the browser fetch the
    // new one instead of showing the cached plate
    stamp: (() => { try {
      return Math.round(statSync(path.join(repoRoot(), "app", "public", "plates-web", `${curve.uid}-1600-grey.png`)).mtimeMs);
    } catch { return 0; } })(),
  }));
const done = rows.filter((row) => row.exported).length;
---

<BaseLayout title="the print plates" pageTitle="The print plates">
  <p class="lead">
    Every curve as a print plate: <b>300 dpi</b>, white ground, turned as its record says,
    in <b>two greys</b> — the left of the vertical axis darker, the right lighter — so a
    two-colour press can tell them apart. Click a thumbnail for the plate; the links under it
    give the PNG, the SVG, and the record the plate was drawn from.
  </p>
  <p class="plates-count">To see what a value does before saving it, open
    <a href="/tune/">the tuning lab</a>: pick a curve and drag width, plus, minus and profile.
    To cut a double-wonky at its blue dot, open <a href="/cut/">the cut desk</a>.</p>
  <p class="plates-count">{done} of {rows.length} plates exported · {rows.length} of
    {registry.curves.length} records chosen (2 stars or more; a new curve joins its parent) ·
    order: {order === "stars"
      ? <><b>stars</b>, a variant beside its parent · <a href="/plates/?order=uid">uid</a></>
      : <><a href="/plates/">stars</a> · <b>uid</b></>} · <a href="/review/">review the
    set</a> · generator <code>scripts/print_plates.mjs</code></p>

  <div class="plates-grid">
    {rows.map((row) => (
      <article class="plate-card">
        <a href={`/tune/${row.uid}`} title="open the tuning engine for this curve">
          <img src={`/api/print-plate/${row.uid}?format=svg&v=${row.stamp}`}
            alt={row.name} loading="lazy" />
        </a>
        <p class="plate-name"><code>{row.uid}</code> {row.name}</p>
        <p class="plate-provenance">{row.provenance}</p>
        <p class="plate-meta">
          {row.exported
            ? <><a href={`/api/print-plate/${row.uid}`}>png 300 dpi</a> ·
                <a href={`/api/print-plate/${row.uid}?format=svg`}>svg</a>{row.web
                  ? <> · <a href={`/plates-web/${row.uid}-1600-grey.png?v=${row.stamp}`}>1600 png</a></> : null} ·</>
            : <span>not exported yet ·</span>}
          turn {row.turn}° · <a href={`/tune/${row.uid}`}>tune</a>
        </p>
        <p class="plate-formula">{row.formula}</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .plates-count { font: 15px/1.4 ui-monospace, Menlo, monospace; color: #5a4a36; }
  .plates-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  .plate-card { border: 1px solid #e6dccb; background: #fffef9; padding: 10px; margin: 0; }
  .plate-card img { width: 100%; height: 220px; object-fit: contain; background: #fff; display: block; }
  .plate-name { margin: 8px 0 2px; font-size: 14px; }
  .plate-meta { margin: 0 0 4px; font-size: 12px; color: #7a6a55; }
  .plate-formula { margin: 0; font-size: 12px; color: #5a4a36; overflow-wrap: anywhere; }
  .plate-provenance { margin: 0 0 6px; font: 13px/1.5 inherit; color: #3f3a33; }
</style>
