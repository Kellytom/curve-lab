---
// The hub: every page the app will use, live, in one scroll. The shell is the
// admin-dashboard layout (fixed sidebar, top bar, card grid); the colours and
// type are curve-lab's own.
import { buildHub } from "../lib/pages.js";
import { tunnelInfo } from "../lib/tunnel.js";

const hub = buildHub();
const tunnel = tunnelInfo();
const sections = [{ key: "app", label: "The app", pages: hub.app }, ...hub.sections];
---

<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>curve-lab — the hub</title>
<style is:global>
:root{--ground:#f6f1e4;--paper:#fffdf7;--line:#d8ccae;--ink:#2e2413;--gold:#8c6a21;--mute:#7b6c4e}
*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);font:15px/1.55 Georgia,serif}
.shell{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}
aside{position:sticky;top:0;height:100vh;overflow:auto;background:var(--paper);
  border-right:1px solid var(--line);padding:18px 0 28px}
.brand{font:600 17px/1.2 Georgia,serif;padding:0 18px 4px}
.brand small{display:block;font:11px/1.5 ui-monospace,Menlo,monospace;color:var(--mute);
  font-weight:400;margin-top:3px}
aside nav{padding:14px 10px 0}
aside a{display:flex;justify-content:space-between;gap:8px;padding:5px 8px;border-radius:3px;
  color:var(--ink);text-decoration:none;font:12px/1.4 ui-monospace,Menlo,monospace}
aside a:hover{background:var(--ground);color:var(--gold)}
aside a b{font-weight:400;color:var(--mute)}
aside .all{margin:14px 10px 0;padding:8px;border-top:1px solid var(--line);
  font:11px/1.5 ui-monospace,Menlo,monospace;color:var(--mute)}
main{min-width:0;padding:0 26px 80px}
.top{position:sticky;top:0;z-index:2;background:var(--ground);border-bottom:1px solid var(--line);
  padding:18px 0 12px;margin-bottom:10px}
h1{font-size:23px;margin:0 0 2px}
.sub{color:var(--mute);font:12px/1.5 ui-monospace,Menlo,monospace;margin:0}
.sub.phone{margin-top:3px}
.sub.phone a{color:var(--gold)}
h2{font-size:18px;margin:34px 0 4px;scroll-margin-top:72px}
h2 .count{font:11px/1.5 ui-monospace,Menlo,monospace;color:var(--mute);font-weight:400;
  margin-left:8px}
.lead{color:var(--mute);font-size:13px;margin:0 0 14px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(460px,1fr));gap:18px}
.card{background:var(--paper);border:1px solid var(--line);padding:0;overflow:hidden}
.card header{display:flex;align-items:baseline;gap:10px;padding:9px 12px;
  border-bottom:1px solid var(--line);background:#fbf7ec}
.card h3{font-size:14px;margin:0;flex:1;min-width:0}
.card h3 span{display:block;font:11px/1.4 ui-monospace,Menlo,monospace;color:var(--mute);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card a{font:11px/1.5 ui-monospace,Menlo,monospace;color:var(--gold);text-decoration:none;
  white-space:nowrap}
.card a:hover{text-decoration:underline}
.card iframe{display:block;width:100%;height:440px;border:0;background:#fff}
.card.tall iframe{height:620px}
@media (max-width:900px){
  .shell{grid-template-columns:1fr}
  aside{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line)}
  aside nav{display:flex;flex-wrap:wrap}
  main{padding:0 14px 60px}
  .grid{grid-template-columns:1fr}
}
</style>
</head><body>
<div class="shell">
<aside>
  <div class="brand">curve-lab<small>the hub · everything in one scroll</small></div>
  <nav>
    {sections.map((section) => (
      <a href={`#${section.key}`}>{section.label}<b>{section.pages.length}</b></a>
    ))}
  </nav>
  <p class="all">{hub.total} pages · the workbench files are served live from
    <code>workbench/</code> at <code>/pages/&lt;file&gt;</code></p>
</aside>
<main>
  <div class="top">
    <h1>The hub</h1>
    <p class="sub">{hub.total} live pages · the app first, then the workbench by intent ·
      scroll, or jump from the left</p>
    <p class="sub phone">{tunnel.url
      ? <>phone: <a href={tunnel.url}>{tunnel.url}</a> · changes when the tunnel restarts</>
      : <>phone: no quick tunnel in {tunnel.logPath} — <code>scripts/service.sh status</code></>}</p>
  </div>

  {sections.map((section) => (
    <section id={section.key}>
      <h2>{section.label}<span class="count">{section.pages.length}</span></h2>
      <div class="grid">
        {section.pages.map((page) => (
          <article class:list={["card", section.key === "app" && "tall"]}>
            <header>
              <h3>{page.title}<span>{page.purpose}</span></h3>
              <a href={page.src} target="_blank" rel="noopener">open ↗</a>
            </header>
            <iframe src={page.src} title={page.title} loading="lazy"></iframe>
          </article>
        ))}
      </div>
    </section>
  ))}
</main>
</div>
</body></html>
