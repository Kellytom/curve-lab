---
// The hub: four live pages, one door to the rest. Layout is Pico CSS
// (classless, vendored at /vendor/pico.min.css) so there is no CSS of ours to
// think about beyond the frame heights.
import { buildHub } from "../lib/pages.js";
import { lanUrls, tunnelInfo } from "../lib/tunnel.js";

const hub = buildHub();
const tunnel = tunnelInfo();
const lan = lanUrls();
const app = hub.app;
const older = hub.total - app.length;
---

<!doctype html>
<html lang="en" data-theme="light"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>curve-lab — the hub</title>
<link rel="stylesheet" href="/vendor/pico.min.css">
<link rel="stylesheet" href="/vendor/curve-lab-theme.css">
<style is:global>
/* only what Pico cannot know: the preview frame height and a two-column grid */
.app-grid{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(26rem,1fr))}
.app-grid article{margin:0}
.app-grid iframe{display:block;width:100%;height:30rem;border:0;background:#fff}
.app-grid h3{margin:0}
.app-grid .purpose{font-size:.8rem;color:var(--pico-muted-color);margin:.2rem 0 .6rem}
.app-grid .open{font-size:.78rem}
.phone{font-size:.85rem}
.hint{font-size:.72rem;color:var(--pico-muted-color);margin:.35rem .1rem 0}
@media (max-width:600px){.app-grid iframe{height:22rem}}
</style>
</head><body>
<nav class="container-fluid">
  <ul><li><strong>curve-lab</strong></li></ul>
  <ul>
    <li><a href="/lab">central design &amp; frame</a></li>
    <li><a href="/book">book</a></li>
    <li><a href="/ph-nth-sandbox">sandbox</a></li>
    <li><a href="/finder">finder</a></li>
    <li><a href="/everything">everything else</a></li>
  </ul>
</nav>
<main class="container">
  <h1>curve-lab</h1>
  <p>Four pages, live. {older} older pages behind one link.</p>
  <p class="phone">{tunnel.url
    ? <>phone: <a href={tunnel.url}>{tunnel.url}</a></>
    : <>phone: no tunnel running — <code>scripts/service.sh status</code></>}
    {lan.length ? <> · home: <a href={lan[0]}>{lan[0]}</a></> : null}</p>

  <div class="app-grid">
    {app.map((page) => (
      <article>
        <header>
          <h3>{page.title}</h3>
          <p class="purpose">{page.purpose}</p>
          <a class="open" href={page.src} target="_blank" rel="noopener">open in a tab ↗</a>
        </header>
        <iframe src={page.src} title={page.title} loading="lazy"></iframe>
        <p class="hint">(scroll inside the frame for more)</p>
      </article>
    ))}
  </div>

  <article style="margin-top:2rem">
    <h2>There's more…</h2>
    <p>Everything else is kept and still working: the generators, the degree ladder's
      notes, the terminal and junction proofs, the catalogues. {older} pages in all,
      grouped by what you are looking for, so this page stays short and the four
      above stay at the top.</p>
    <p><a class="button" href="/everything" role="button">the full page list →</a></p>
  </article>
</main>
</body></html>
