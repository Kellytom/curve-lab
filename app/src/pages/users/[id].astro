---
import { findUser, removeUser, updateUser, ROLES } from "../../lib/users.js";
import { sameOrigin } from "../../lib/http.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
const id = String(Astro.params.id);
let error = "";

if (Astro.request.method === "POST") {
  if (!sameOrigin(Astro.request, Astro.url)) {
    return new Response("bad origin", { status: 403 });
  }
  const form = await Astro.request.formData();
  if (String(form.get("intent") || "save") === "delete") {
    const result = await removeUser(id);
    if (result.ok) return Astro.redirect("/users", 303);
    error = result.error || "the remove failed";
  } else {
    const result = await updateUser(id, {
      name: String(form.get("name") || ""),
      email: String(form.get("email") || ""),
      role: String(form.get("role") || "viewer"),
      notes: String(form.get("notes") || ""),
    });
    if (result.ok) return Astro.redirect("/users", 303);
    error = result.error;
  }
}

const user = await findUser(id);
if (!user) return Astro.redirect("/users", 303);
---

<BaseLayout title="a person" pageTitle={`${user.name} — users`}>
  <h1>{user.name}</h1>
  <p><small>id <code>{user.id}</code> · created {user.created?.slice(0, 10)}</small></p>

  {error ? <article aria-invalid="true"><strong>{error}</strong></article> : null}

  <form method="post">
    <label>Name <input name="name" value={user.name} required maxlength="80"></label>
    <div class="grid">
      <label>Address <input name="email" type="email" value={user.email} maxlength="200"></label>
      <label>Role
        <select name="role">
          {ROLES.map((role) => <option value={role} selected={role === user.role}>{role}</option>)}
        </select>
      </label>
    </div>
    <label>Note <textarea name="notes" maxlength="500" rows="3">{user.notes}</textarea></label>
    <button type="submit">Save</button>
  </form>

  <form method="post" onsubmit="return confirm('Remove this user?')">
    <input type="hidden" name="intent" value="delete">
    <button type="submit" class="secondary outline">Remove this user</button>
  </form>

  <p><a href="/users">all users</a></p>
</BaseLayout>
