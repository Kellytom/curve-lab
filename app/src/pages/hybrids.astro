---
// The hybrid desk: the candidates still in play — starred, not rejected, and not part of a
// named family page (the wonks live at /hybrids-wonk/). Sorted by stars.
//
// The markup is the template component; this page only supplies the rows.
// Spec: state/SPEC-hybrids-int.md
import { readFileSync } from "node:fs";
import path from "node:path";
import { repoRoot } from "../lib/gallery.js";
import { prisma } from "../lib/db.js";
import HybridDesk from "../components/HybridDesk.astro";

const read = (name) => JSON.parse(readFileSync(path.join(repoRoot(), "workbench", name), "utf8"));
const data = read("hybrids.json");
const doubleData = read("doubles.json");
const rejected = new Map((read("hybrid-rejected.json").rejected || []).map((row) => [row.id, row]));

// the decisions, live from the database
const stored = await prisma.sandboxCurve.findMany();
const decisions = new Map();
for (const row of stored) {
  try { decisions.set(row.name, JSON.parse(row.data)); } catch { /* a bad row is not a decision */ }
}

const decorate = (candidate) => {
  const decision = decisions.get(candidate.id) || {};
  return {
    ...candidate,
    curveName: String(decision.curveName || ""),
    importance: Number(decision.importance) || 0,
    decision: String(decision.decision || ""),
    placeholder: `hybrid-${candidate.p}-${candidate.q}-${candidate.use === "colour" ? "colour" : `${candidate.block}-${candidate.use}`}`,
  };
};

// a double wonky is the deliverable: it appears here once its half has been liked
// (a star is the "like"; a save is a decision to keep the half as well)
const likedHalves = new Set(
  [...decisions.entries()]
    .filter(([, row]) => (Number(row.importance) || 0) > 0 || row.decision === "saved")
    .map(([name]) => name),
);
// mirror doubles made with the little ⇋ button live in the database, and sit beside their parent
const storedRows = await prisma.sandboxCurve.findMany();
const mirrors = [];
for (const stored of storedRows) {
  try {
    const data = JSON.parse(stored.data);
    if (data.construction?.kind !== "double" || !data.construction?.mirror) continue;
    const parent = data.construction.parent;
    mirrors.push({
      id: stored.name,
      parent,
      kind: "double",
      points: data.points || [],
      figure: `${stored.name}.svg`,
      crossings: data.construction?.crossings ?? 0,
      p: data.construction?.p ?? data.p, q: data.construction?.q ?? data.q,
      curveName: data.curveName || stored.name,
      importance: Number(data.importance) || 0,
      decision: data.decision || "",
      placeholder: stored.name,
      note: data.construction?.note || "",
      construction: data.construction,
      formula: {
        plain: data.formula?.plain || "",
        internal: data.formula?.internal || "",
        middle: data.formula?.middle || "",
        use: `mirror of ${parent} across the y axis`,
        search: `${data.formula?.plain || ""} mirrored across the y axis`,
      },
    });
  } catch { /* not a mirror row */ }
}

// a double reaches the desk when its half is liked OR when the double itself was saved
const doubles = (doubleData.doubles || [])
  .map(decorate)
  .filter((row) => likedHalves.has(row.parent) || row.decision === "saved"
    || (Number(row.importance) || 0) > 0);

const byParent = new Map();
for (const mirror of mirrors) {
  if (!byParent.has(mirror.parent)) byParent.set(mirror.parent, []);
  byParent.get(mirror.parent).push(mirror);
}

const base = [...(data.candidates || []).map(decorate), ...doubles];
const sorted = base
  // a note or a rejection takes the card off the desk
  .filter((row) => row.decision !== "notes" && row.decision !== "rejected")
  // "wonk" is a staging label, not a family: while a candidate is still named wonk-<n> it
  // sits on the wonk page; once it has a real name it belongs here
  .filter((row) => !/^wonk-\d+$/i.test(row.curveName))
  // a recorded reject stays out unless it was starred or saved afterwards
  .filter((row) => {
    const record = rejected.get(row.id);
    return !record || record.reinstated;
  })
  .sort((a, b) => b.importance - a.importance
    || b.crossings - a.crossings
    || a.id.localeCompare(b.id));

// a mirror sits directly after the curve it mirrors, whatever the sort said
const rows = sorted
  .filter((row) => !String(row.id).startsWith("mirror-"))
  .flatMap((row) => [row, ...(byParent.get(row.id) || [])]);
for (const [parent, list] of byParent) {
  if (!rows.some((row) => row.id === parent)) rows.push(...list);
}

const starGroups = new Map();
const byId = new Map(rows.map((row) => [row.id, row]));
for (const row of rows) {
  // a mirror belongs to its parent's group, so the two stay side by side
  const parentImportance = row.parent ? (byId.get(row.parent)?.importance || 0) : 0;
  const importance = row.importance > 0 ? row.importance : parentImportance;
  const key = importance > 0 ? `${importance} stars` : "unstarred, still in play";
  if (!starGroups.has(key)) starGroups.set(key, []);
  starGroups.get(key).push(row);
}
const groups = [...starGroups.entries()].map(([title, list]) => ({ title, rows: list }));
---

<HybridDesk
  title="the hybrid desk"
  lead="The candidates still in play: starred, not rejected, and not on a named family page (the wonks are at /hybrids-wonk/). Sorted by stars, highest first. Save, move to notes or reject — saved to the database."
  groups={groups}
  count={rows.length}
/>
