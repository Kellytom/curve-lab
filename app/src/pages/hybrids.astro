---
// The hybrid desk: every candidate, one card each. The markup is the template component
// (app/src/components/HybridDesk.astro); this page only supplies the rows.
// Spec: state/SPEC-hybrids-int.md
import { readFileSync } from "node:fs";
import path from "node:path";
import { repoRoot } from "../lib/gallery.js";
import HybridDesk from "../components/HybridDesk.astro";

const data = JSON.parse(readFileSync(path.join(repoRoot(), "workbench", "hybrids.json"), "utf8"));
const candidates = (data.candidates || []).map((row) => ({
  ...row,
  placeholder: `hybrid-${row.p}-${row.q}-${row.use === "colour" ? "colour" : `${row.block}-${row.use}`}`,
}));

const bySheet = new Map();
for (const row of candidates) {
  const sheet = row.use === "colour" ? "colour" : row.block;
  if (!bySheet.has(sheet)) bySheet.set(sheet, []);
  bySheet.get(sheet).push(row);
}
---

<HybridDesk
  title="the hybrid desk"
  lead="Every candidate of x = C(t)^p, y = S(t)^q, with the middle-term polynomial of (x + y)^n used in 2D: as a tint (colour) or as a radial scale (radius). One decision each — Save, move to notes or reject — saved to the database. Nothing is deleted here."
  groups={[...bySheet.entries()]}
  count={candidates.length}
/>
