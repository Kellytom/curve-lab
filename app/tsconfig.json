{
  // Astro's own base settings, then the checks that catch the faults this app
  // has actually had: a name used out of scope in a page script, a property
  // that does not exist, a function called with the wrong shape.
  //
  //   npx astro check
  //
  // `base` allows JavaScript in the pages, because they are .astro files with
  // small scripts, not a TypeScript rewrite. Strict null checks are on; that
  // is where a missing value shows up before a browser does.
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "src/lib/name-parts.js",
    "src/lib/star-list.js",
    "src/lib/finder-sections.js",
    "src/lib/duplicates.js",
    "src/lib/registry.js",
    "src/lib/curve-notes.js"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": false
  }
}
