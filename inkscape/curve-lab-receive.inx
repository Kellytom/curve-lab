<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/extensions/1.0">
  <name>Curve Lab: receive a curve</name>
  <id>curve-lab.receive</id>
  <param name="path" type="string" gui-text="Path to the .svg carrying the recipe"></param>
  <effect needs-document="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Curve Lab"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">ph_extension.py</command>
  </script>
</inkscape-extension>
